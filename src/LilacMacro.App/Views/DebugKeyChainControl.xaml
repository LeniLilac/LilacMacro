<UserControl x:Class="LilacMacro.App.Views.DebugKeyChainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             Focusable="True"
             PreviewKeyDown="Control_OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="KEY CHAIN" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
            <Border x:Name="StatusBorder"
                    Grid.Column="1"
                    Background="{DynamicResource MutedBrush}"
                    BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="2"
                    CornerRadius="3"
                    Padding="7,3">
                <TextBlock x:Name="StatusText"
                           Text="IDLE"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="9"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="KEY" Style="{StaticResource EyebrowStyle}" />
            <TextBlock Grid.Column="1" Text="HOLD MS" Style="{StaticResource EyebrowStyle}" Margin="8,0,0,0" />
        </Grid>

        <ItemsControl x:Name="KeyRows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding KeyName}"
                                Tag="{Binding}"
                                Style="{StaticResource CompactButtonStyle}"
                                Click="Key_OnClick" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding HoldMillisecondsText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactTextBoxStyle}"
                                 Margin="8,0,0,0" />
                        <Button Grid.Column="2"
                                Tag="{Binding}"
                                Style="{StaticResource CompactButtonStyle}"
                                Margin="8,0,0,0"
                                Click="Remove_OnClick">
                            <controls:LucideIcon Width="14"
                                                 Height="14"
                                                 Data="{StaticResource Lucide.Trash2}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <UniformGrid Columns="2" Margin="0,3,0,0">
            <Button x:Name="AddButton"
                    Content="ADD"
                    Style="{StaticResource CompactButtonStyle}"
                    Margin="0,0,4,0"
                    Click="Add_OnClick" />
            <Button x:Name="ArmButton"
                    Content="ARM"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinHeight="34"
                    Padding="8,4"
                    Margin="4,0,0,0"
                    Click="Arm_OnClick" />
        </UniformGrid>
    </StackPanel>
</UserControl>
