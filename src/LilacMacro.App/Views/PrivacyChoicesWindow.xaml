<Window x:Class="LilacMacro.App.Views.PrivacyChoicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LilacMacro privacy choices"
        Width="820"
        Height="600"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ChoiceCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="20,17" />
        </Style>
        <Style x:Key="ChoiceCheckStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="24" FontWeight="Black" Text="PRIVACY &amp; ONLINE FEATURES" />
            <ScrollViewer Grid.Row="1" Margin="0,20,0,18" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource ChoiceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock FontSize="16" FontWeight="Bold" Text="Online services" />
                                <TextBlock Margin="0,7,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="Uses the official LilacMacro service and GitHub for updates, safety controls, code claiming, and Plan sharing. Local automation remains available when this is off." />
                            </StackPanel>
                            <CheckBox x:Name="OnlineFeaturesCheck" Grid.Column="1"
                                      Style="{StaticResource ChoiceCheckStyle}" Content="ENABLED" IsChecked="True" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ChoiceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock FontSize="16" FontWeight="Bold" Text="Usage data" />
                                <TextBlock Margin="0,7,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="Shares limited events about feature use, rewards, classified errors, OCR timing, app version, and coarse device capability. It never sends screenshots, credentials, file paths, webhook URLs, raw hardware identifiers, or free-form error text." />
                            </StackPanel>
                            <CheckBox x:Name="TelemetryCheck" Grid.Column="1"
                                      Style="{StaticResource ChoiceCheckStyle}" Content="ENABLED" IsChecked="True" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ChoiceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock FontSize="16" FontWeight="Bold" Text="Deep Debug error uploads" />
                                <TextBlock Margin="0,7,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="After a classified macro error, sends the completed Deep Debug log. This pauses when Deep Debug logging is off or low disk space temporarily disables it. A sent log is removed locally; a failed upload stays in the shared Deep Debug folder." />
                            </StackPanel>
                            <CheckBox x:Name="AutomaticReportsCheck" Grid.Column="1"
                                      Style="{StaticResource ChoiceCheckStyle}" Content="ENABLED" IsChecked="True" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="SaveErrorText"
                       Grid.Row="2"
                       Margin="0,0,0,12"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Padding="12,7" Style="{StaticResource ButtonStyle}"
                            Click="Privacy_OnClick" Content="PRIVACY" />
                    <Button Margin="8,0,0,0" Padding="12,7" Style="{StaticResource ButtonStyle}"
                            Click="Terms_OnClick" Content="TERMS" />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="150" Padding="18,10"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Continue_OnClick" Content="SAVE &amp; CONTINUE" />
            </Grid>
    </Grid>
</Window>
