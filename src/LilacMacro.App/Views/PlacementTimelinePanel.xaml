<UserControl x:Class="LilacMacro.App.Views.PlacementTimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             xmlns:placements="clr-namespace:LilacMacro.Core.Placements;assembly=LilacMacro.Core"
             PreviewMouseWheel="TimelinePanel_OnPreviewMouseWheel">
    <UserControl.Resources>
        <Style x:Key="PanelMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="TimelineItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent"><ContentPresenter /></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTabStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,22,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="3" VerticalAlignment="Bottom"
                                    Background="Transparent" CornerRadius="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                <Setter Property="FontWeight" Value="Black" />
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}" Padding="13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StepsTabButton" Style="{StaticResource SectionTabStyle}"
                            Tag="Active" Content="MATCH STEPS" Click="StepsTab_OnClick" />
                    <Button x:Name="SettingsTabButton" Style="{StaticResource SectionTabStyle}"
                            Content="MATCH SETTINGS" Click="SettingsTab_OnClick" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="PlaybackStatusText"
                               MaxWidth="210" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource InkSoftBrush}"
                               FontSize="10" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="TestSetupButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinHeight="30" Padding="9,4"
                            Click="TestSetupButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon x:Name="TestSetupIcon"
                                                 Width="13" Height="13" Margin="0,0,6,0"
                                                 Data="{StaticResource Lucide.Play}" />
                            <TextBlock x:Name="TestSetupText"
                                       VerticalAlignment="Center" Text="TEST SETUP" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddStepButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinHeight="30" Padding="9,4" Click="AddStepButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon Width="13" Height="13" Margin="0,0,6,0"
                                                 Data="{StaticResource Lucide.Plus}" />
                            <TextBlock VerticalAlignment="Center" Text="ADD STEP" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PopOutButton"
                            Style="{StaticResource PanelMiniButtonStyle}"
                            Content="POPOUT" Click="PopOutButton_OnClick" />
                </StackPanel>
            </Grid>

            <Grid x:Name="StepsPanel" Grid.Row="1" Margin="0,10,0,0">
            <ListBox x:Name="TimelineList"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False"
                     ItemContainerStyle="{StaticResource TimelineItemStyle}"
                     PreviewMouseMove="TimelineList_OnPreviewMouseMove"
                     PreviewMouseLeftButtonUp="TimelineList_OnPreviewMouseLeftButtonUp"
                     LostMouseCapture="TimelineList_OnLostMouseCapture">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowCard" Padding="8" Cursor="SizeAll"
                                        Background="{DynamicResource MutedBrush}"
                                        BorderBrush="{DynamicResource ChromeBorderBrush}"
                                        BorderThickness="1" CornerRadius="3"
                                        PreviewMouseLeftButtonDown="StepDragHandle_OnPreviewMouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ActionAccent" Width="4" Height="32"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource MatchStepPlacementBrush}"
                                                CornerRadius="2" />
                                        <Border Grid.Column="1" Background="Transparent">
                                            <controls:LucideIcon Width="15" Height="15"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource InkSoftBrush}"
                                                                 Data="{StaticResource Lucide.GripVertical}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="2,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="StepTitle" Text="{Binding Title}"
                                                       FontSize="11" FontWeight="Black"
                                                       Foreground="{DynamicResource MatchStepPlacementBrush}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Detail}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                       FontWeight="Bold" Foreground="{DynamicResource InkSoftBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Style="{StaticResource PanelMiniButtonStyle}" Tag="{Binding}"
                                                    Content="EDIT" IsEnabled="{Binding CanEdit}" Click="EditStep_OnClick" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource PanelMiniButtonStyle}"
                                                    Tag="{Binding}" IsEnabled="{Binding CanDelete}"
                                                    Click="DeleteStep_OnClick">
                                                <controls:LucideIcon Width="13" Height="13"
                                                                     Data="{StaticResource Lucide.Trash2}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Step.Kind}" Value="{x:Static placements:PlacementStepKind.Reconfigure}">
                                        <Setter TargetName="ActionAccent" Property="Background" Value="{DynamicResource MatchStepReconfigureBrush}" />
                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource MatchStepReconfigureBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step.Kind}" Value="{x:Static placements:PlacementStepKind.StartGame}">
                                        <Setter TargetName="ActionAccent" Property="Background" Value="{DynamicResource MatchStepStartBrush}" />
                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource MatchStepStartBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step.Kind}" Value="{x:Static placements:PlacementStepKind.Delay}">
                                        <Setter TargetName="ActionAccent" Property="Background" Value="{DynamicResource MatchStepDelayBrush}" />
                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource MatchStepDelayBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step.Kind}" Value="{x:Static placements:PlacementStepKind.Upgrade}">
                                        <Setter TargetName="ActionAccent" Property="Background" Value="{DynamicResource MatchStepUpgradeBrush}" />
                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource MatchStepUpgradeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step.Kind}" Value="{x:Static placements:PlacementStepKind.Sell}">
                                        <Setter TargetName="ActionAccent" Property="Background" Value="{DynamicResource MatchStepSellBrush}" />
                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource MatchStepSellBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="RowCard" Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
                                        <Setter TargetName="RowCard" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
            </ListBox>
            </Grid>

            <Border x:Name="SettingsPanel" Grid.Row="1" Margin="0,10,0,0" Padding="16"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                <ScrollViewer x:Name="SettingsScrollViewer"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="Bold" Text="Defaults" />
                        <StackPanel Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"
                                           Text="DEFAULT TARGETING" />
                                <ComboBox Grid.Column="1" Width="280" HorizontalAlignment="Left" SelectedIndex="0">
                                    <ComboBoxItem Content="First" />
                                    <ComboBoxItem Content="Last" />
                                    <ComboBoxItem Content="Closest" />
                                    <ComboBoxItem Content="Strongest" />
                                    <ComboBoxItem Content="Boss" />
                                    <ComboBoxItem Content="Weakest" />
                                    <ComboBoxItem Content="Shielded" />
                                    <ComboBoxItem Content="Fastest" />
                                    <ComboBoxItem Content="None" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"
                                           Text="DEFAULT AUTO UPGRADE" />
                                <ComboBox Grid.Column="1" Width="280" HorizontalAlignment="Left" SelectedIndex="1">
                                    <ComboBoxItem Content="Off" />
                                    <ComboBoxItem Content="Priority 1" />
                                    <ComboBoxItem Content="Priority 2" />
                                    <ComboBoxItem Content="Priority 3" />
                                    <ComboBoxItem Content="Priority 4" />
                                    <ComboBoxItem Content="Priority 5" />
                                    <ComboBoxItem Content="Priority 6" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"
                                           Text="BETWEEN UNIT CHECKS, MS" />
                                <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="900" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"
                                           Text="PLACEMENT ATTEMPTS" />
                                <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="1" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"
                                           Text="IMPOSSIBILITY THRESHOLD, MIN" />
                                <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="0" />
                            </Grid>
                        </StackPanel>

                        <Button x:Name="AdvancedSettingsButton" Margin="0,16,0,0"
                                HorizontalContentAlignment="Stretch"
                                Style="{StaticResource ButtonStyle}"
                                Click="AdvancedSettingsButton_OnClick">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" FontWeight="Black"
                                           Text="ADVANCED SETTINGS" />
                                <controls:LucideIcon x:Name="AdvancedSettingsChevron"
                                                     Width="15" Height="15"
                                                     HorizontalAlignment="Right"
                                                     Data="{StaticResource Lucide.ChevronDown}" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="AdvancedSettingsFields" Margin="0,20,0,0"
                                    Visibility="Collapsed">
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Step mode actions" />
                            <StackPanel Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="AFTER UNIT SELECTION, MS" />
                                    <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="250" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="PLACEMENT CLICK BURST, MS" />
                                    <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="50" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="BEFORE SELECTING UNIT, MS" />
                                    <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="0" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="BEFORE SELECTED-UNIT CHECK, MS" />
                                    <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="0" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="BETWEEN ACTION KEYS, MS" />
                                    <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="100" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="BETWEEN UPGRADES, MS" />
                                    <TextBox x:Name="BetweenUpgradeAttemptsText"
                                             Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                             LostKeyboardFocus="BetweenUpgradeAttempts_OnLostKeyboardFocus"
                                             KeyDown="BetweenUpgradeAttempts_OnKeyDown" />
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="VERIFICATION" />
                                    <StackPanel Grid.Column="1">
                                        <CheckBox IsChecked="True" Content="Require placement proof" />
                                        <CheckBox Margin="0,9,0,0" IsChecked="True" Content="Require reconfigure proof" />
                                        <CheckBox Margin="0,9,0,0" IsChecked="True" Content="Wait for upgrade readiness" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Margin="0,20,0,18" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0" />
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Recording mode start" />
                            <StackPanel Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="START SCREEN" />
                                    <CheckBox Grid.Column="1" IsChecked="True" Content="Require start screen" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="PLAYBACK START DELAY, MS" />
                                    <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Text="0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
