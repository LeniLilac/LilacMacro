<UserControl x:Class="LilacMacro.App.Views.TeamSwapTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="TEAM SWAP TEST" Style="{StaticResource PageTitleStyle}" />
            <Border x:Name="StatusBand" HorizontalAlignment="Right" MinWidth="140"
                    Style="{StaticResource ChipStyle}" Background="{DynamicResource MutedBrush}">
                <TextBlock x:Name="StatusText" Text="IDLE" HorizontalAlignment="Center" FontWeight="Bold" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="TEAM SWAP" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="UNIT TEAMS OPEN" Style="{StaticResource FieldLabelStyle}" Margin="0,5,0,18" />
                    <TextBlock Text="TRIALS" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TrialsBox" Text="20" Margin="0,5,0,18" />
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" Click="RunButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.Shuffle}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="RUN RANDOM SWAPS" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource DangerButtonStyle}" Margin="0,10,0,0"
                            IsEnabled="False" Click="StopButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.Square}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="STOP" />
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PASSED" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="PassedText" Text="0" FontFamily="Cascadia Mono" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FAILED" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="FailedText" Text="0" FontFamily="Cascadia Mono" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="TRIALS" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="ProgressText" Text="0 / 0" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource InkSoftBrush}" FontFamily="Cascadia Mono" />
                    </Grid>
                    <ListView x:Name="TrialList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                              Focusable="False"
                              ItemContainerStyle="{StaticResource ReadOnlyTableItemStyle}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="#" Width="65" DisplayMemberBinding="{Binding Trial}" />
                                <GridViewColumn Header="TEAM" Width="90" DisplayMemberBinding="{Binding Team}" />
                                <GridViewColumn Header="RESULT" Width="100" DisplayMemberBinding="{Binding Result}" />
                                <GridViewColumn Header="TIME" Width="110" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="STATUS" Width="430" DisplayMemberBinding="{Binding Status}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
