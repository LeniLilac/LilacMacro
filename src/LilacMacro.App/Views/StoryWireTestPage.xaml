<UserControl x:Class="LilacMacro.App.Views.StoryWireTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             xmlns:debugging="clr-namespace:LilacMacro.App.Debugging;assembly=LilacMacro.Runtime">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="WIRE TEST" Style="{StaticResource PageTitleStyle}" />
            <Border x:Name="StatusBand" Grid.Column="1" Style="{StaticResource ChipStyle}"
                    Background="{DynamicResource MutedBrush}" MinWidth="145">
                <TextBlock x:Name="StatusText" Text="IDLE" FontWeight="Bold" HorizontalAlignment="Center" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="NAVIGATION" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="GAME MODE" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5" />
                    <ComboBox x:Name="GameModeBox" SelectedIndex="0" SelectionChanged="GameModeBox_OnSelectionChanged">
                        <ComboBoxItem Content="STORY" Tag="Story" />
                        <ComboBoxItem Content="RAID" Tag="Raid" />
                        <ComboBoxItem Content="CHALLENGE" Tag="Challenge" />
                    </ComboBox>
                    <TextBlock Text="WIRE MODE" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" />
                    <ComboBox x:Name="WireModeBox" SelectedIndex="0">
                        <ComboBoxItem Content="OCR" />
                        <ComboBoxItem Content="IMAGE + OCR FALLBACK" />
                    </ComboBox>
                    <TextBlock Text="TEAM" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" />
                    <ComboBox x:Name="TeamBox" SelectedIndex="0">
                        <ComboBoxItem Content="1" /><ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" /><ComboBoxItem Content="4" />
                        <ComboBoxItem Content="5" /><ComboBoxItem Content="6" />
                        <ComboBoxItem Content="7" /><ComboBoxItem Content="8" />
                    </ComboBox>
                    <StackPanel x:Name="MapFieldsPanel">
                        <TextBlock Text="MAP" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5" />
                        <ComboBox x:Name="MapBox" SelectedIndex="0">
                            <ComboBoxItem Content="School Grounds" />
                        </ComboBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACT" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5" />
                                <ComboBox x:Name="ActBox" SelectedIndex="0" SelectionChanged="ActBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Act 1" Tag="Act1" /><ComboBoxItem Content="Act 2" Tag="Act2" />
                                    <ComboBoxItem Content="Act 3" Tag="Act3" /><ComboBoxItem Content="Act 4" Tag="Act4" />
                                    <ComboBoxItem Content="Act 5" Tag="Act5" /><ComboBoxItem Content="Infinite" Tag="Infinite" />
                                    <ComboBoxItem Content="Mastery" Tag="Mastery" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DIFFICULTY" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5" />
                                <ComboBox x:Name="DifficultyBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Normal" /><ComboBoxItem Content="Hard" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="ChallengeTypesPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="CHALLENGE TYPES" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5" />
                        <UniformGrid Columns="3">
                            <CheckBox x:Name="TraitTypeToggle" Content="TRAIT" IsChecked="True"
                                      Style="{StaticResource MultiBoxSelectorStyle}" Margin="0,0,6,0" />
                            <CheckBox x:Name="StatTypeToggle" Content="STAT" IsChecked="True"
                                      Style="{StaticResource MultiBoxSelectorStyle}" Margin="0,0,6,0" />
                            <CheckBox x:Name="SpriteTypeToggle" Content="SPRITE" IsChecked="True"
                                      Style="{StaticResource MultiBoxSelectorStyle}" />
                        </UniformGrid>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="UNITS KEY" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5" />
                            <ComboBox x:Name="UnitsKeyBox" SelectedIndex="7" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OCR" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5" />
                            <Button x:Name="DeviceButton" Content="CPU" Style="{StaticResource ButtonStyle}"
                                    Click="DeviceButton_OnClick" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="KeepLoadedToggle" Content="KEEP LOADED" Margin="0,16,0,0"
                              Checked="KeepLoaded_OnChanged" Unchecked="KeepLoaded_OnChanged" />
                    <CheckBox x:Name="RunRuntimeToggle" Content="RUN PLACEMENTS + MATCH" Margin="0,10,0,0"
                              Checked="RunRuntime_OnChanged" Unchecked="RunRuntime_OnChanged" />
                    <CheckBox x:Name="RepeatStageToggle" Content="REPEAT STAGE" Margin="0,10,0,0" IsEnabled="False" />
                    <Button x:Name="SetupButton" Content="SET UP OCR" Style="{StaticResource ButtonStyle}"
                            Margin="0,12,0,0" Click="SetupButton_OnClick" />
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                            Click="RunButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.Play}" Width="15" Height="15" Margin="0,0,7,0" />
                            <TextBlock x:Name="RunButtonText" Text="RUN WIRE" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource DangerButtonStyle}" Margin="0,10,0,0"
                            IsEnabled="False" Click="StopButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.Square}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="STOP" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="330" /></Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <ItemsControl x:Name="StageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                                        Background="{DynamicResource CardBrush}" CornerRadius="3" Padding="12,9" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" /><ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" />
                                        <Border Grid.Column="2" Padding="7,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                                                    <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static debugging:StoryWireStageStatus.Running}"><Setter Property="Background" Value="{DynamicResource YellowBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static debugging:StoryWireStageStatus.Passed}"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static debugging:StoryWireStageStatus.Failed}"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{DynamicResource InkSoftBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,14,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="OCR / IMAGE" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="82" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" /><ColumnDefinition Width="110" /><ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="65" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="STATE" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="ELEMENT" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Column="2" Text="IMAGE" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Column="3" Text="SCORE" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Column="4" Text="TIME" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Column="5" Text="RESULT" Style="{StaticResource FieldLabelStyle}" />
                                </Grid>
                                <ListBox x:Name="ComparisonList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                         SelectionChanged="ComparisonList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="95" /><ColumnDefinition Width="110" /><ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="65" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding State}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding ImageStatus}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Score, StringFormat={}{0:P1}}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Timing}" FontFamily="Cascadia Mono" FontSize="9" />
                                                <Border Grid.Column="5" Padding="6,1" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Agrees}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Agreement}" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Coordinates}"
                                                           Foreground="{DynamicResource InkSoftBrush}" FontFamily="Cascadia Mono"
                                                           FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="ComparisonPreviewEmpty" Grid.Row="3" Text="NO IMAGE RESULT"
                                           Foreground="{DynamicResource InkSoftBrush}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid x:Name="ComparisonPreviewPanel" Grid.Row="3" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="ComparisonPreviewTitle" FontFamily="{StaticResource MonoFont}"
                                               FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <Border Height="112" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1">
                                                <Image x:Name="WireMedianImage" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="PROFILE" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Border Height="112" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1">
                                                <Image x:Name="WireReliabilityImage" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="RELIABILITY" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                            <Border Height="112" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1">
                                                <Image x:Name="WireMatchedImage" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="LIVE CROP" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Border Grid.Column="1" Background="{DynamicResource ChromeBorderBrush}" />
                        <Grid Grid.Column="2" Margin="14,0,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="WIRE LOG" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox x:Name="EventLog" Grid.Row="2" BorderThickness="0" Background="Transparent"
                                     FontFamily="Cascadia Mono" FontSize="10" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
