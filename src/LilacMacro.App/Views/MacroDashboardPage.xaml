<UserControl x:Class="LilacMacro.App.Views.MacroDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls">
    <UserControl.Resources>
        <Style x:Key="DashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="11,5" />
        </Style>
        <Style x:Key="DashboardMonoStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        </Style>
        <Style x:Key="DashboardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <DataTemplate x:Key="UpcomingTaskTemplate">
            <Border Margin="0,0,0,7"
                    Padding="9,8"
                    Background="{DynamicResource MutedBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding Position}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="9"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   Text="{Binding Detail}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{DynamicResource InkSoftBrush}"
                               Text="{Binding Progress}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="DashboardRoot" MinWidth="1740" Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <TextBlock VerticalAlignment="Center" FontSize="19" FontWeight="Black" Text="MACRO" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="PLAN" />
                <ComboBox x:Name="PlanCombo" Width="190" SelectionChanged="PlanCombo_OnSelectionChanged" />
                <Button x:Name="StartButton" Margin="9,0,0,0" Style="{StaticResource DashboardButtonStyle}"
                        Background="{DynamicResource AccentBrush}" IsEnabled="False" Click="StartButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Width="14" Height="14" Margin="0,0,6,0" Data="{StaticResource Lucide.Play}" />
                        <TextBlock x:Name="StartButtonText" Text="SETTING UP OCR" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Margin="7,0,0,0" Style="{StaticResource DashboardButtonStyle}"
                        Background="{DynamicResource DangerBrush}" IsEnabled="False" Click="StopButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Width="13" Height="13" Margin="0,0,6,0" Data="{StaticResource Lucide.Square}" />
                        <TextBlock Text="STOP" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DockColumn" Width="1396" />
                <ColumnDefinition x:Name="DockSpacerColumn" Width="14" />
                <ColumnDefinition Width="*" MinWidth="304" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DockCard" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,11">
                        <StackPanel Visibility="Collapsed" Orientation="Horizontal">
                            <controls:LucideIcon Width="15" Height="15" Margin="0,0,7,0" Data="{StaticResource Lucide.Crosshair}" />
                            <TextBlock FontSize="12" FontWeight="Black" Text="ROBLOX" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock x:Name="DockStatusText"
                                       Visibility="Collapsed"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource EyebrowStyle}"
                                       Text="READY · 1366 x 700" />
                            <Button x:Name="DockButton"
                                    MinHeight="28"
                                    Padding="9,3"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="DockButton_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Width="13"
                                                         Height="13"
                                                         Margin="0,0,6,0"
                                                         Data="{StaticResource Lucide.Crosshair}" />
                                    <TextBlock x:Name="DockButtonText" Text="DOCK" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <controls:RobloxDockSurface x:Name="RobloxDock"
                                                Grid.Row="1"
                                                Margin="14,0,14,12"
                                                DockStateChanged="RobloxDock_OnStateChanged" />
                    <Grid Grid.Row="2" Margin="14,0,14,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource EyebrowStyle}" Text="OUTCOME" />
                            <TextBlock x:Name="LastOutcomeText" Margin="9,0,0,0" FontWeight="Bold" Text="NONE" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource DashboardMonoStyle}" Text="PLANNED RUNTIME" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="StatsCard" Grid.Column="2" Padding="15" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="205" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Width="15" Height="15" Margin="0,0,7,0" Data="{StaticResource Lucide.ChartNoAxesCombined}" />
                        <TextBlock FontSize="12" FontWeight="Black" Text="STATS" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="10,11"
                            Background="{DynamicResource MutedBrush}"
                            BorderBrush="{DynamicResource ChromeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Width="20" Height="20" VerticalAlignment="Center" Data="{StaticResource Lucide.Timer}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource DashboardLabelStyle}" Text="RUNTIME" />
                                <TextBlock x:Name="RuntimeText"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="29"
                                           FontWeight="Black"
                                           LineHeight="31"
                                           Text="00:00:00" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <controls:RunStatsChart x:Name="StatsChart" Grid.Row="3" />

                    <Grid Grid.Row="5" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource Lucide.ListOrdered}" />
                            <TextBlock FontSize="11" FontWeight="Black" Text="UPCOMING TASKS" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource DashboardMonoStyle}"
                                   Text="PRIORITY ORDER" />
                    </Grid>
                    <ScrollViewer Grid.Row="6"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="UpcomingTasksList"
                                      HorizontalAlignment="Stretch"
                                      ItemTemplate="{StaticResource UpcomingTaskTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="13,10" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Width="15" Height="15" Margin="0,0,7,0" Data="{StaticResource Lucide.ListChecks}" />
                        <TextBlock FontSize="12" FontWeight="Black" Text="RUN LOG" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="TraceLogText" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFont}" FontSize="10" Text="Macro runtime is not connected." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
