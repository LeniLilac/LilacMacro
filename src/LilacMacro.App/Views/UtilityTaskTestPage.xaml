<UserControl x:Class="LilacMacro.App.Views.UtilityTaskTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="UTILITY TASK TESTS" Style="{StaticResource PageTitleStyle}" />
            <Border x:Name="StatusBand" HorizontalAlignment="Right" MinWidth="140"
                    Style="{StaticResource ChipStyle}" Background="{DynamicResource MutedBrush}">
                <TextBlock x:Name="StatusText" Text="IDLE" HorizontalAlignment="Center" FontWeight="Bold" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="TASK" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="PRODUCTION UTILITY FLOW" Style="{StaticResource FieldLabelStyle}" Margin="0,5,0,18" />

                    <TextBlock Text="UTILITY" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="TaskBox" Margin="0,5,0,14" SelectionChanged="TaskBox_OnSelectionChanged" />

                    <StackPanel x:Name="ShopItemsPanel">
                        <TextBlock Text="ITEMS" Style="{StaticResource FieldLabelStyle}" />
                        <ItemsControl x:Name="ShopItemsList" Margin="0,5,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Width="185" Margin="0,4,8,4" Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" Click="RunButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.Play}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="RUN TEST" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource DangerButtonStyle}" Margin="0,10,0,0"
                            IsEnabled="False" Click="StopButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.Square}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="STOP" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RUN LOG" Style="{StaticResource SectionTitleStyle}" />
                    <ListBox x:Name="RunLog" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             FontFamily="Cascadia Mono" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
