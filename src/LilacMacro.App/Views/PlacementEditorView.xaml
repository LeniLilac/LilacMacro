<UserControl x:Class="LilacMacro.App.Views.PlacementEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Focusable="True"
             PreviewMouseWheel="PlacementEditor_OnPreviewMouseWheel"
             PreviewKeyDown="PlacementEditor_OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style x:Key="CursorModeButtonStyle" TargetType="RadioButton"
               BasedOn="{StaticResource PlacementChoiceButtonStyle}">
            <Setter Property="Width" Value="139" />
            <Setter Property="MinWidth" Value="139" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackToMapsButton" Height="38" Padding="13,5" Style="{StaticResource ButtonStyle}"
                    Content="BACK TO MAPS" Click="BackToMaps_OnClick" />
            <TextBlock x:Name="BreadcrumbText" Grid.Column="1" Margin="16,0"
                       VerticalAlignment="Center" FontSize="18" FontWeight="Black"
                       TextTrimming="CharacterEllipsis" />
            <ComboBox x:Name="RouteSelector" Grid.Column="2" Width="190"
                      Margin="0,0,8,0" DisplayMemberPath="Display"
                      SelectionChanged="RouteSelector_OnSelectionChanged" />
            <ComboBox x:Name="TeamSelector" Grid.Column="3" Width="150" Margin="0,0,8,0"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectionChanged="TeamSelector_OnSelectionChanged" />
            <Button x:Name="CopySetupButton" Grid.Column="5" Margin="0,0,8,0" Style="{StaticResource CompactButtonStyle}"
                    Content="COPY SETUP" Click="CopySetup_OnClick" />
            <Button x:Name="ResetButton" Grid.Column="6" Width="76"
                    Style="{StaticResource CompactButtonStyle}"
                    Background="{DynamicResource DangerBrush}"
                    Content="RESET" Click="Reset_OnClick" />
            <ComboBox x:Name="ViewSelector" Grid.Column="4" Width="150" Margin="0,0,8,0"
                      DisplayMemberPath="Label" SelectionChanged="ViewSelector_OnSelectionChanged" />
        </Grid>

        <ScrollViewer x:Name="WorkspaceScrollViewer"
                      Grid.Row="1"
                      Margin="0,18,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <Border Height="760" Padding="8" Background="{DynamicResource MutedBrush}"
                    BorderBrush="{DynamicResource InkBrush}" BorderThickness="3" CornerRadius="5">
                <Grid x:Name="MapViewportHost" ClipToBounds="True"
                      SizeChanged="MapViewportHost_OnSizeChanged">
                    <ScrollViewer x:Name="MapViewport"
                                  Background="{DynamicResource CardBrush}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  PanningMode="Both"
                                  SizeChanged="MapViewport_OnSizeChanged"
                                  PreviewMouseDown="MapViewport_OnMouseMiddleButtonDown"
                                  MouseMove="MapViewport_OnMouseMove"
                                  PreviewMouseUp="MapViewport_OnMouseMiddleButtonUp"
                                  LostMouseCapture="MapViewport_OnLostMouseCapture">
                        <Border x:Name="MapPanFrame" Padding="800,760">
                        <Grid x:Name="MapSurface" Width="1366" Height="700"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource CardBrush}"
                              MouseLeftButtonDown="MapSurface_OnMouseLeftButtonDown"
                              MouseMove="MapSurface_OnMouseMove"
                              MouseLeave="MapSurface_OnMouseLeave">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1" />
                        </Grid.LayoutTransform>
                        <Image x:Name="MapImage" Stretch="Fill" />
                        <ItemsControl x:Name="PlacementMarkers" Width="1366" Height="700"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding MarkerLayout.CanvasLeft}" />
                                    <Setter Property="Canvas.Top" Value="{Binding MarkerLayout.CanvasTop}" />
                                    <Setter Property="Panel.ZIndex" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="1000" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="MarkerRoot"
                                          Width="{Binding MarkerLayout.CanvasWidth}"
                                          Height="{Binding MarkerLayout.CanvasHeight}"
                                          Background="Transparent"
                                          RenderTransformOrigin="0.363636,0.782609"
                                          PreviewMouseLeftButtonDown="PlacementMarker_OnPreviewMouseLeftButtonDown">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding MarkerScale}" ScaleY="{Binding MarkerScale}" />
                                        </Grid.RenderTransform>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Cursor" Value="Cross" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid x:Name="MarkerLabel">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNearPointer}" Value="True">
                                                            <Setter Property="Opacity" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Width="42" Height="24" Margin="5,3,19,19"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{DynamicResource InkBrush}"
                                                    CornerRadius="3" />
                                            <Button Width="42" Height="24" Margin="2,0,22,22"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    IsHitTestVisible="{Binding IsSelectionMode}"
                                                    Focusable="False" Cursor="Hand"
                                                    Tag="{Binding}"
                                                    Click="PlacementMarkerDelete_OnClick">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="MarkerLabelFace"
                                                                Background="{DynamicResource CardBrush}"
                                                                BorderBrush="{DynamicResource InkBrush}"
                                                                BorderThickness="2" CornerRadius="3">
                                                            <Grid>
                                                                <TextBlock x:Name="MarkerLabelText"
                                                                           Margin="5,2,0,0"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Top"
                                                                           FontSize="10" FontWeight="Black"
                                                                           Foreground="{DynamicResource InkBrush}"
                                                                           Text="{Binding MarkerLabel}" />
                                                                <Border x:Name="MarkerLabelRule"
                                                                        Width="32" Height="2" Margin="3,0,3,3"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Bottom"
                                                                        Background="{DynamicResource PinkBrush}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="MarkerLabelFace" Property="Background"
                                                                        Value="{DynamicResource DangerBrush}" />
                                                                <Setter TargetName="MarkerLabelRule" Property="Background"
                                                                        Value="{DynamicResource InkBrush}" />
                                                                <Setter TargetName="MarkerLabelText" Property="Text" Value="DELETE" />
                                                                <Setter TargetName="MarkerLabelText" Property="Margin" Value="0" />
                                                                <Setter TargetName="MarkerLabelText" Property="HorizontalAlignment" Value="Center" />
                                                                <Setter TargetName="MarkerLabelText" Property="VerticalAlignment" Value="Center" />
                                                                <Setter TargetName="MarkerLabelText" Property="FontSize" Value="8" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="MarkerLabelFace" Property="Background"
                                                                        Value="{DynamicResource PressedSurfaceBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                        <Border Width="3" Height="8" Margin="22.5,23,40.5,15"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{DynamicResource InkBrush}"
                                                Opacity="{Binding PinOpacity}"
                                                IsHitTestVisible="False" />
                                        <Border x:Name="MarkerStem" Width="1" Height="8" Margin="23.5,23,41.5,15"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{DynamicResource PinkBrush}"
                                                Opacity="{Binding PinOpacity}"
                                                IsHitTestVisible="False" />
                                        <primitives:Thumb x:Name="MarkerThumb" Width="14" Height="14" Margin="17,29,35,3"
                                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                                          Cursor="SizeAll"
                                                          Opacity="{Binding PinOpacity}"
                                                          IsEnabled="{Binding IsSelectionMode}"
                                                          DragStarted="PlacementMarker_OnDragStarted"
                                                          DragDelta="PlacementMarker_OnDragDelta"
                                                          DragCompleted="PlacementMarker_OnDragCompleted">
                                            <primitives:Thumb.Template>
                                                <ControlTemplate TargetType="primitives:Thumb">
                                                    <Grid>
                                                        <Ellipse Margin="2,2,0,0"
                                                                 Fill="{DynamicResource InkBrush}" />
                                                        <Ellipse x:Name="PlacementDot"
                                                                 Margin="0,0,2,2"
                                                                 Fill="{DynamicResource PinkBrush}"
                                                                 Stroke="{DynamicResource InkBrush}"
                                                                 StrokeThickness="2" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="PlacementDot" Property="Fill"
                                                                    Value="{DynamicResource YellowBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="PlacementDot" Property="Fill"
                                                                    Value="{DynamicResource CardBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </primitives:Thumb.Template>
                                        </primitives:Thumb>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                        </Border>
                    </ScrollViewer>

                    <Border x:Name="UnitPalette"
                            Width="306" Padding="8,6,8,8"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource InkBrush}"
                            BorderThickness="2" CornerRadius="4">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="UnitPaletteOffset" X="12" Y="12" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"
                                           Text="MODE" />
                                <primitives:Thumb Width="24" Height="18" HorizontalAlignment="Right" Cursor="SizeAll"
                                                  DragDelta="UnitPalette_OnDragDelta">
                                <primitives:Thumb.Template>
                                    <ControlTemplate TargetType="primitives:Thumb">
                                        <Grid Background="Transparent">
                                            <controls:LucideIcon Width="14" Height="14" HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource InkSoftBrush}"
                                                                 Data="{StaticResource Lucide.GripVertical}" />
                                        </Grid>
                                    </ControlTemplate>
                                </primitives:Thumb.Template>
                                </primitives:Thumb>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PlaceModeButton" GroupName="PlacementCursor" Tag="Place"
                                             Style="{StaticResource CursorModeButtonStyle}" IsChecked="True"
                                             Click="CursorMode_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LucideIcon Width="14" Height="14" Margin="0,0,7,0"
                                                             Data="{StaticResource Lucide.Crosshair}" />
                                        <TextBlock VerticalAlignment="Center" Text="PLACE" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SelectModeButton" GroupName="PlacementCursor" Tag="Select"
                                             Style="{StaticResource CursorModeButtonStyle}"
                                             Click="CursorMode_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LucideIcon Width="14" Height="14" Margin="0,0,7,0"
                                                             Data="{StaticResource Lucide.MousePointerClick}" />
                                        <TextBlock VerticalAlignment="Center" Text="SELECT" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,4" Style="{StaticResource FieldLabelStyle}"
                                       Text="UNIT SLOT" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Unit1Button" GroupName="PlacementUnit" Tag="1" Content="1"
                                             Style="{StaticResource PlacementChoiceButtonStyle}" Checked="UnitButton_OnChecked" />
                                <RadioButton x:Name="Unit2Button" GroupName="PlacementUnit" Tag="2" Content="2"
                                             Style="{StaticResource PlacementChoiceButtonStyle}" Checked="UnitButton_OnChecked" />
                                <RadioButton x:Name="Unit3Button" GroupName="PlacementUnit" Tag="3" Content="3"
                                             Style="{StaticResource PlacementChoiceButtonStyle}" Checked="UnitButton_OnChecked" />
                                <RadioButton x:Name="Unit4Button" GroupName="PlacementUnit" Tag="4" Content="4"
                                             Style="{StaticResource PlacementChoiceButtonStyle}" Checked="UnitButton_OnChecked" />
                                <RadioButton x:Name="Unit5Button" GroupName="PlacementUnit" Tag="5" Content="5"
                                             Style="{StaticResource PlacementChoiceButtonStyle}" Checked="UnitButton_OnChecked" />
                                <RadioButton x:Name="Unit6Button" GroupName="PlacementUnit" Tag="6" Content="6"
                                             Style="{StaticResource PlacementChoiceButtonStyle}" Checked="UnitButton_OnChecked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="TimelineHost" Grid.Row="2" />
            </Grid>
        </ScrollViewer>

        <Grid x:Name="CopySetupOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed">
            <Border Background="{DynamicResource CanvasBrush}" Opacity="0.58" />
            <Border Width="480" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="2" CornerRadius="5">
                <StackPanel>
                    <Grid>
                        <TextBlock FontSize="13" FontWeight="Black" Text="COPY SETUP" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource CompactButtonStyle}"
                                ToolTip="Close" Click="CloseCopySetup_OnClick">
                            <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.X}" />
                        </Button>
                    </Grid>
                    <TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabelStyle}" Text="SOURCE MAP" />
                    <ComboBox x:Name="CopySourceMapSelector" DisplayMemberPath="CopyLabel"
                              SelectionChanged="CopySourceMapSelector_OnSelectionChanged" />
                    <TextBlock Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" Text="SOURCE ROUTE" />
                    <ComboBox x:Name="CopySourceRouteSelector" DisplayMemberPath="Label" />
                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Text="Copies team, defaults, placements, and every timeline action. Reference views of one map already share a setup." />
                    <StackPanel Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CompactButtonStyle}" Content="CANCEL"
                                Click="CloseCopySetup_OnClick" />
                        <Button Margin="8,0,0,0" Style="{StaticResource CompactButtonStyle}"
                                Background="{DynamicResource AccentBrush}" Content="COPY"
                                Click="ApplyCopySetup_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
