<UserControl x:Class="LilacMacro.App.Views.DiagnosticUploadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             Loaded="DiagnosticUploadPanel_OnLoaded">
    <Border Margin="0,0,0,12"
            Padding="15"
            Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="15" FontWeight="Bold" Text="Diagnostic upload" />
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="REMOTE UPLOAD" />
                    <CheckBox x:Name="AllowUploadsCheck"
                              Grid.Column="1"
                              Content="Allow selected archive uploads"
                              Checked="AllowUploads_OnChanged"
                              Unchecked="AllowUploads_OnChanged" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="INSTALLATION ID" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="InstallationIdText"
                                 Width="360"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="Loading..." />
                        <Button x:Name="CopyInstallationIdButton"
                                Margin="8,0,0,0"
                                MinHeight="33"
                                Padding="10,5"
                                IsEnabled="False"
                                Click="CopyInstallationId_OnClick"
                                Content="COPY" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="LARGE FILE GRANT" />
                    <PasswordBox x:Name="LargeGrantPassword"
                                 Grid.Column="1"
                                 Width="360"
                                 HorizontalAlignment="Left"
                                 IsEnabled="False" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="ACTIONS" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="UploadButton"
                                MinHeight="33"
                                Padding="10,5"
                                IsEnabled="False"
                                Click="Upload_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Width="14" Height="14" Margin="0,0,7,0"
                                                     Data="{StaticResource Lucide.Upload}" />
                                <TextBlock Text="UPLOAD ARCHIVE" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton"
                                Margin="8,0,0,0"
                                MinHeight="33"
                                Padding="10,5"
                                IsEnabled="False"
                                Click="Cancel_OnClick"
                                Content="CANCEL" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusText"
                                   FontSize="10"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   Text="Opt-in disabled" />
                        <ProgressBar x:Name="UploadProgress"
                                     Height="5"
                                     Margin="0,7,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
