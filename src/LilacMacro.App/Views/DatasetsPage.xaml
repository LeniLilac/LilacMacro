<UserControl x:Class="LilacMacro.App.Views.DatasetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="38,30,38,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DATASETS" FontSize="19" FontWeight="Black" Margin="0,0,0,5" />
                <TextBlock x:Name="RootText" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="REFRESH" Style="{StaticResource ButtonStyle}" VerticalAlignment="Top" Click="Refresh_OnClick" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <ListBox x:Name="DatasetList" BorderThickness="0" Background="Transparent" SelectionChanged="DatasetList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource MutedBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" CornerRadius="4" Padding="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Black" />
                                            <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ChipStyle}" Background="{Binding StateBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Black" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="NO DATASETS" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Background="{StaticResource YellowBrush}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SELECTED DATASET" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock x:Name="SelectionName" Text="Choose a dataset" FontSize="20" FontWeight="Black" Margin="0,8,0,7" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectionPath" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InkSoftBrush}" />
                        <Button x:Name="OpenButton" Content="OPEN IN REVIEW" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,8" IsEnabled="False" Click="Open_OnClick" />
                        <Button x:Name="ExplorerButton" Content="SHOW IN EXPLORER" Style="{StaticResource ButtonStyle}" IsEnabled="False" Click="Explorer_OnClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
