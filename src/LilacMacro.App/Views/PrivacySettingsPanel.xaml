<UserControl x:Class="LilacMacro.App.Views.PrivacySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,0,0,12" Padding="15" Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock FontSize="15" FontWeight="Bold" Text="Privacy and connected services" />
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ONLINE SERVICES" />
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="OnlineFeaturesCheck" Content="Use updates, safety controls, code claiming, and Plan sharing"
                                  Checked="Choice_OnChanged" Unchecked="Choice_OnChanged" />
                        <TextBlock Margin="0,5,0,0" FontSize="9" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                                   Text="Connects only to the official LilacMacro service and GitHub. Turning it off keeps local automation available but disables these online features." />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="USAGE DATA" />
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="TelemetryCheck" Content="Share limited usage and performance data"
                                  Checked="Choice_OnChanged" Unchecked="Choice_OnChanged" />
                        <TextBlock Margin="0,5,0,0" FontSize="9" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                                   Text="Includes feature use, rewards, classified errors, OCR timing, and coarse device capability. Never includes screenshots, credentials, file paths, webhook URLs, or free-form error text." />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ERROR LOG UPLOADS" />
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="AutomaticReportsCheck" Content="Send Deep Debug logs automatically after macro errors"
                                  Checked="Choice_OnChanged" Unchecked="Choice_OnChanged" />
                        <TextBlock Margin="0,5,0,0" FontSize="9" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                                   Text="Requires Deep Debug logging. No log is sent while Deep Debug is off or paused for low disk space. Sent logs are removed locally; failed uploads remain in the Deep Debug folder." />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="POLICIES" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="112" Style="{DynamicResource SettingsButtonStyle}" Click="Privacy_OnClick" Content="PRIVACY" />
                        <Button Width="112" Margin="8,0,0,0" Style="{DynamicResource SettingsButtonStyle}" Click="Terms_OnClick" Content="TERMS" />
                        <TextBlock x:Name="SavedText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="9"
                                   Foreground="{DynamicResource InkSoftBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
