<UserControl x:Class="LilacMacro.App.Views.TeamScrollAbTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="SCROLL A/B TEST" Style="{StaticResource PageTitleStyle}" />
            <Border x:Name="StatusBand" HorizontalAlignment="Right" MinWidth="140"
                    Style="{StaticResource ChipStyle}" Background="{DynamicResource MutedBrush}">
                <TextBlock x:Name="StatusText" Text="IDLE" HorizontalAlignment="Center" FontWeight="Bold" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="TEAM SCROLL" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="UNIT TEAMS OPEN" Style="{StaticResource FieldLabelStyle}" Margin="0,5,0,18" />

                    <TextBlock Text="TRIALS" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TrialsBox" Text="20" Margin="0,5,0,14" />

                    <TextBlock Text="DOWN SCROLL UNITS" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ScrollUnitsBox" Text="600" Margin="0,5,0,14" />

                    <TextBlock Text="SCROLL INCREMENT" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ScrollIncrementBox" Text="10" Margin="0,5,0,18" />

                    <Button x:Name="RunDragButton" Style="{StaticResource PrimaryButtonStyle}"
                            Click="RunDragButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.GripVertical}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="RUN DRAG" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunScrollButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"
                            Click="RunScrollButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.ChevronDown}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="RUN SCROLL" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource DangerButtonStyle}" Margin="0,10,0,0"
                            IsEnabled="False" Click="StopButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.Square}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="STOP" />
                        </StackPanel>
                    </Button>

                    <Border Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="DRAG" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="DragSummaryText" Text="—" FontFamily="Cascadia Mono" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="SCROLL" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0" />
                            <TextBlock x:Name="ScrollSummaryText" Text="—" FontFamily="Cascadia Mono" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="OpenResultsButton" Margin="0,12,0,0" IsEnabled="False"
                            Click="OpenResultsButton_OnClick">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:LucideIcon Data="{StaticResource Lucide.FolderOpen}" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="OPEN RESULTS" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="TRIALS" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="ProgressText" Text="0 / 0" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource InkSoftBrush}" FontFamily="Cascadia Mono" />
                    </Grid>
                    <ListView x:Name="TrialList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                              Focusable="False"
                              ItemContainerStyle="{StaticResource ReadOnlyTableItemStyle}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="#" Width="55" DisplayMemberBinding="{Binding Trial}" />
                                <GridViewColumn Header="METHOD" Width="100" DisplayMemberBinding="{Binding Method}" />
                                <GridViewColumn Header="UNITS" Width="90" DisplayMemberBinding="{Binding ScrollUnits}" />
                                <GridViewColumn Header="POSITION" Width="120" DisplayMemberBinding="{Binding Position}" />
                                <GridViewColumn Header="THUMB" Width="240" DisplayMemberBinding="{Binding Bounds}" />
                                <GridViewColumn Header="STATUS" Width="180" DisplayMemberBinding="{Binding Status}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Border Grid.Row="4" Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="10">
                        <TextBlock x:Name="OutputPathText" Text="NO RESULTS" TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkSoftBrush}" FontFamily="Cascadia Mono" FontSize="10" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
