<Window x:Class="LilacMacro.App.Views.GpuOcrSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LilacMacro GPU OCR setup"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="36,30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Width="78" Height="78" HorizontalAlignment="Left"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="3">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="44" FontWeight="Black" Text="L" />
            </Border>
            <TextBlock Margin="0,26,0,0" FontSize="34" FontWeight="Black"
                       TextWrapping="Wrap" Text="Prepare your GPU" />
            <TextBlock Margin="0,16,0,0" FontSize="14" LineHeight="21"
                       Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                       Text="LilacMacro includes CPU OCR. This optional step installs the matching NVIDIA OCR runtime for faster inference." />
            <TextBlock Margin="0,22,0,0" FontSize="12" FontWeight="Bold"
                       TextWrapping="Wrap" Text="No driver or system-wide software is installed. GPU packages stay in this Windows user's local LilacMacro folder." />
            <TextBlock Margin="0,24,0,0" FontFamily="Consolas" FontSize="10"
                       Foreground="{DynamicResource InkSoftBrush}"
                       Text="OCR SETUP  /  PER-USER GPU RUNTIME" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="24" FontWeight="Black" Text="GPU OCR SETUP" />
            <TextBlock x:Name="GpuDetailsText" Grid.Row="1" Margin="0,8,0,0"
                       FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource InkSoftBrush}"
                       TextWrapping="Wrap" />
            <Border Grid.Row="2" Margin="0,18,0,14" Padding="13,11"
                    Background="{DynamicResource YellowBrush}"
                    BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontSize="16" FontWeight="Black" Text="READY TO SET UP" />
                    <ProgressBar x:Name="SetupProgress" Height="12" Margin="0,12,0,0" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="ProgressText" Margin="0,7,0,0" FontFamily="Consolas" FontSize="10"
                               Foreground="{DynamicResource InkSoftBrush}" Text="Waiting to start..." />
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Padding="12" Background="{DynamicResource MutedBrush}"
                    BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="4">
                <TextBox x:Name="LogText"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="10"
                         HorizontalScrollBarVisibility="Disabled"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Border>
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RetryButton" Padding="12,7" Click="Retry_OnClick" Content="RETRY" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" MinWidth="130" Padding="12,8" Click="Cancel_OnClick" Content="CANCEL SETUP" />
                    <Button x:Name="ContinueButton" Grid.Column="1" MinWidth="170" Margin="8,0,0,0"
                            Padding="16,9" Background="{DynamicResource AccentBrush}"
                            Click="Continue_OnClick" Content="CONTINUE WITH CPU" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
