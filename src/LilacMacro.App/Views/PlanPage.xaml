<UserControl x:Class="LilacMacro.App.Views.PlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             xmlns:local="clr-namespace:LilacMacro.App.Views">
    <UserControl.Resources>
        <Style x:Key="PlanCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="PlanIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Width" Value="31" />
            <Setter Property="MinWidth" Value="31" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="PlanModeChoiceButtonStyle"
               TargetType="RadioButton"
               BasedOn="{StaticResource PlacementChoiceButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PlanTaskOptionSectionStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="PlanTaskOptionLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Black" />
        </Style>
        <Style x:Key="PlanRowActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="PlanRowEditButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PlanRowActionButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
        <Style x:Key="PlanBlockItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlanRowBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2,1,1,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:PlanTaskPrototype}">
            <Border Style="{StaticResource PlanRowBorderStyle}" MouseLeftButtonDown="BlockRow_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <Button Width="25" MinWidth="25" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="SizeAll" Tag="{Binding}" ToolTip="Drag to reorder"
                            PreviewMouseLeftButtonDown="BlockDragHandle_OnPreviewMouseLeftButtonDown">
                        <controls:LucideIcon Width="15" Height="15" Foreground="{DynamicResource InkSoftBrush}"
                                             Data="{StaticResource Lucide.GripVertical}" />
                    </Button>
                    <Border Grid.Column="1" Width="24" Height="24" Background="{DynamicResource AccentBrush}" CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black"
                                   Foreground="{DynamicResource OnAccentBrush}" Text="{Binding Priority}" />
                    </Border>
                    <TextBlock Grid.Column="2" Margin="6,0,8,0" VerticalAlignment="Center" FontWeight="Black"
                               Text="{Binding ModeLabel}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock FontWeight="Black" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource InkSoftBrush}"
                                   Text="{Binding TargetLabel}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="10"
                               Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Status}" />
                    <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource PlanRowEditButtonStyle}" Tag="{Binding}" Content="EDIT"
                                ToolTip="Edit" Click="EditTask_OnClick" />
                        <Button Margin="4,0,0,0" Style="{StaticResource PlanIconButtonStyle}" Tag="{Binding}"
                                ToolTip="Delete" Click="DeleteTask_OnClick">
                            <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.Trash2}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:PlanLoopPrototype}">
            <Border Padding="8" Style="{StaticResource PlanRowBorderStyle}" MouseLeftButtonDown="BlockRow_OnMouseLeftButtonDown">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Width="25" MinWidth="25" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                Cursor="SizeAll" Tag="{Binding}" ToolTip="Drag to reorder" IsEnabled="{Binding CanReorder}"
                                PreviewMouseLeftButtonDown="BlockDragHandle_OnPreviewMouseLeftButtonDown">
                            <controls:LucideIcon Width="15" Height="15" Foreground="{DynamicResource InkSoftBrush}"
                                                 Data="{StaticResource Lucide.GripVertical}" />
                        </Button>
                        <TextBlock Grid.Column="1" Margin="5,0,14,0" VerticalAlignment="Center" FontWeight="Black" Text="{Binding Label}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource InkSoftBrush}"
                                   Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{StaticResource PlanIconButtonStyle}" Tag="{Binding}" ToolTip="Add task to loop" Click="AddTaskToLoop_OnClick">
                                <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.Plus}" />
                            </Button>
                            <Button Margin="4,0,0,0" Style="{StaticResource PlanIconButtonStyle}" Tag="{Binding}" ToolTip="Loop settings" Click="EditLoop_OnClick">
                                <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.Settings2}" />
                            </Button>
                            <Button Margin="4,0,0,0" Style="{StaticResource PlanIconButtonStyle}" Tag="{Binding}" ToolTip="Remove loop" Click="DeleteLoop_OnClick">
                                <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.Trash2}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListBox Margin="28,7,0,0" ItemsSource="{Binding Children}" BorderThickness="0"
                             Background="{DynamicResource MutedBrush}" ItemContainerStyle="{StaticResource PlanBlockItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Loaded="BlockList_OnLoaded" PreviewMouseMove="BlockList_OnPreviewMouseMove"
                             PreviewMouseLeftButtonUp="BlockList_OnPreviewMouseLeftButtonUp"
                             LostMouseCapture="BlockList_OnLostMouseCapture" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="19" FontWeight="Black" Text="PLAN" />

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="11" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PlanSelector" SelectionChanged="PlanSelector_OnSelectionChanged" />
                <TextBox x:Name="PlanNameText" Grid.Column="2" MaxLength="100" TextChanged="PlanNameText_OnTextChanged" />
                <StackPanel Grid.Column="3" Margin="9,0,0,0" Orientation="Horizontal">
                    <Button Style="{StaticResource PlanCompactButtonStyle}" Click="NewPlan_OnClick" Content="NEW" />
                    <Button Margin="6,0,0,0" Style="{StaticResource PlanCompactButtonStyle}" Click="CopyPlan_OnClick" Content="COPY" />
                    <Button Margin="6,0,0,0" Style="{StaticResource PlanCompactButtonStyle}" Click="SharePlan_OnClick" Content="SHARE" />
                    <Button Margin="6,0,0,0" Style="{StaticResource PlanIconButtonStyle}" Background="{DynamicResource DangerBrush}" Click="DeletePlan_OnClick">
                        <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.Trash2}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="13" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="2" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <controls:LucideIcon Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource Lucide.ListChecks}" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Black" Text="PLAN BLOCKS" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PlanCompactButtonStyle}" Click="ResetProgress_OnClick" Content="RESET PROGRESS" />
                        <Button Margin="6,0,0,0" Style="{StaticResource PlanCompactButtonStyle}" Background="{DynamicResource AccentBrush}" Click="AddTask_OnClick">
                            <StackPanel Orientation="Horizontal"><controls:LucideIcon Width="13" Height="13" Margin="0,0,5,0" Data="{StaticResource Lucide.Plus}" /><TextBlock Text="ADD TASK" /></StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0" Style="{StaticResource PlanCompactButtonStyle}" Click="AddLoop_OnClick">
                            <StackPanel Orientation="Horizontal"><controls:LucideIcon Width="13" Height="13" Margin="0,0,5,0" Data="{StaticResource Lucide.Plus}" /><TextBlock Text="ADD LOOP" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="BlockItems" Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Blocks}"
                         BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PlanBlockItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Loaded="BlockList_OnLoaded" PreviewMouseMove="BlockList_OnPreviewMouseMove"
                         PreviewMouseLeftButtonUp="BlockList_OnPreviewMouseLeftButtonUp"
                         LostMouseCapture="BlockList_OnLostMouseCapture" />
            </Grid>
        </Border>

        <Grid x:Name="TaskEditorOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed">
            <Border Background="{DynamicResource CanvasBrush}" Opacity="0.58" />
            <Border Width="720" MaxHeight="780" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="TaskEditorTitle" FontSize="13" FontWeight="Black" Text="ADD TASK" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource PlanIconButtonStyle}" Click="CloseTaskEditor_OnClick">
                            <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.X}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ADD TO" />
                            <ComboBox x:Name="TaskDestinationCombo" Margin="0,6,0,0" DisplayMemberPath="Name" />
                            <TextBlock Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" Text="MODE" />
                            <UniformGrid Columns="3" Rows="2" Margin="-4">
                                <RadioButton x:Name="ChallengeModeButton" GroupName="TaskMode" Tag="Challenge" Content="CHALLENGE" Style="{StaticResource PlanModeChoiceButtonStyle}" Checked="TaskModeButton_OnChecked" />
                                <RadioButton x:Name="ExpeditionModeButton" GroupName="TaskMode" Tag="Expedition" Content="EXPEDITION" Style="{StaticResource PlanModeChoiceButtonStyle}" Checked="TaskModeButton_OnChecked" />
                                <RadioButton x:Name="StoryModeButton" GroupName="TaskMode" Tag="Story" Content="STORY" Style="{StaticResource PlanModeChoiceButtonStyle}" Checked="TaskModeButton_OnChecked" />
                                <RadioButton x:Name="RaidModeButton" GroupName="TaskMode" Tag="Raid" Content="RAID" Style="{StaticResource PlanModeChoiceButtonStyle}" Checked="TaskModeButton_OnChecked" />
                                <RadioButton x:Name="EventModeButton" GroupName="TaskMode" Tag="Event" Content="EVENT" Style="{StaticResource PlanModeChoiceButtonStyle}" Checked="TaskModeButton_OnChecked" />
                                <RadioButton x:Name="UtilitiesModeButton" GroupName="TaskMode" Tag="Utilities" Content="UTILITIES" Style="{StaticResource PlanModeChoiceButtonStyle}" Checked="TaskModeButton_OnChecked" />
                            </UniformGrid>
                            <StackPanel x:Name="TaskSchedulePanel" Margin="0,10,0,0">
                                <Border x:Name="TaskRoutePanel" Style="{StaticResource PlanTaskOptionSectionStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="ROUTE" />
                                        <ComboBox x:Name="TaskRouteCombo" Grid.Column="1" Width="220" Margin="24,0,0,0" HorizontalAlignment="Right"
                                                  SelectionChanged="TaskRouteCombo_OnSelectionChanged" />
                                    </Grid>
                                </Border>
                                <Border x:Name="TaskTargetPanel" Style="{StaticResource PlanTaskOptionSectionStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TaskTargetLabel" Style="{StaticResource PlanTaskOptionLabelStyle}" Text="VICTORIES" />
                                        <TextBox x:Name="TaskTargetText" Grid.Column="1" Width="220" Margin="24,0,0,0" HorizontalAlignment="Right" Text="15" />
                                    </Grid>
                                </Border>
                                <Border x:Name="TaskShopItemsPanel" Style="{StaticResource PlanTaskOptionSectionStyle}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="ITEMS" />
                                        <ItemsControl x:Name="TaskShopItemsList" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Width="440" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Width="210" Margin="0,3,10,3" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="TaskOptionsPanel">
                                <Border x:Name="TaskRetriesPanel" Style="{StaticResource PlanTaskOptionSectionStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="DEFEAT RETRIES" />
                                        <TextBox x:Name="TaskRetriesText" Grid.Column="1" Width="220" Margin="24,0,0,0" HorizontalAlignment="Right" Text="0" />
                                    </Grid>
                                </Border>
                                <Border x:Name="TaskChallengePanel" Style="{StaticResource PlanTaskOptionSectionStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="CHALLENGE TYPES" />
                                        <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                            <CheckBox x:Name="TaskTraitCheck" Margin="0,0,8,0" IsChecked="True" Content="Trait" Style="{StaticResource MultiBoxSelectorStyle}" />
                                            <CheckBox x:Name="TaskStatCheck" Margin="0,0,8,0" IsChecked="True" Content="Stat" Style="{StaticResource MultiBoxSelectorStyle}" />
                                            <CheckBox x:Name="TaskSpriteCheck" IsChecked="True" Content="Sprite" Style="{StaticResource MultiBoxSelectorStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="TaskExpeditionPanel">
                                    <Border Style="{StaticResource PlanTaskOptionSectionStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="DIFFICULTY" />
                                            <ComboBox x:Name="TaskDifficultyCombo" Grid.Column="1" Width="220" Margin="24,0,0,0" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource PlanTaskOptionSectionStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="EXTRACTION" />
                                            <CheckBox x:Name="TaskExtractCheck" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" IsChecked="True" Content="At checkpoint" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource PlanTaskOptionSectionStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="BOSS NODES FIRST" />
                                            <TextBox x:Name="TaskBossNodesText" Grid.Column="1" Width="220" Margin="24,0,0,0" HorizontalAlignment="Right" Text="1" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource PlanTaskOptionSectionStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="OPTIMIZE REWARD" />
                                            <ComboBox x:Name="TaskRewardTargetCombo" Grid.Column="1" Width="220" Margin="24,0,0,0" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border x:Name="TaskStoryPanel" Style="{StaticResource PlanTaskOptionSectionStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TaskOptionLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource PlanTaskOptionLabelStyle}" Text="STORY OPTIONS" />
                                        <CheckBox x:Name="TaskHardModeCheck" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" Content="Hard mode" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PlanCompactButtonStyle}" Click="CloseTaskEditor_OnClick" Content="CANCEL" />
                        <Button Margin="7,0,0,0" Style="{StaticResource PlanCompactButtonStyle}" Background="{DynamicResource AccentBrush}" Click="ApplyTaskEditor_OnClick" Content="APPLY" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="LoopEditorOverlay" Grid.RowSpan="3" Panel.ZIndex="110" Visibility="Collapsed">
            <Border Background="{DynamicResource CanvasBrush}" Opacity="0.58" />
            <Border Width="340" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource InkBrush}" BorderThickness="2" CornerRadius="5">
                <StackPanel>
                    <Grid><TextBlock x:Name="LoopEditorTitle" FontSize="13" FontWeight="Black" Text="LOOP SETTINGS" /><Button HorizontalAlignment="Right" Style="{StaticResource PlanIconButtonStyle}" Click="CloseLoopEditor_OnClick"><controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.X}" /></Button></Grid>
                    <Grid Margin="0,16,0,0"><TextBlock VerticalAlignment="Center" FontWeight="Black" Text="FOREVER" /><CheckBox x:Name="LoopForeverCheck" HorizontalAlignment="Right" IsChecked="True" Checked="LoopForeverCheck_OnChanged" Unchecked="LoopForeverCheck_OnChanged" /></Grid>
                    <Border Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0"><StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="REPEAT COUNT" /><TextBox x:Name="LoopRepeatCountText" Margin="0,6,0,0" Text="2" /></StackPanel></Border>
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Style="{StaticResource PlanCompactButtonStyle}" Click="CloseLoopEditor_OnClick" Content="CANCEL" /><Button Margin="7,0,0,0" Style="{StaticResource PlanCompactButtonStyle}" Background="{DynamicResource AccentBrush}" Click="ApplyLoopEditor_OnClick" Content="APPLY" /></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
