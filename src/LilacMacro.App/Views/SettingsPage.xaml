<UserControl x:Class="LilacMacro.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             xmlns:local="clr-namespace:LilacMacro.App.Views"
             Focusable="True"
             Unloaded="SettingsPage_OnUnloaded"
             PreviewKeyDown="SettingsPage_OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SettingsTabStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource MutedBrush}" /></Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource MutedBrush}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="15" />
        </Style>
        <DataTemplate x:Key="SettingsKeyBindingTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Scope}" />
                </StackPanel>
                <Button Grid.Column="1" Height="32" Style="{StaticResource SettingsButtonStyle}" Tag="{Binding}"
                        Click="KeyBindingButton_OnClick" Content="{Binding KeyName}" />
                <Button Grid.Column="3" Height="32" Padding="7,4" Tag="{Binding}"
                        Click="UnsetBinding_OnClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUnset}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.X}" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock FontSize="19" FontWeight="Black" Text="SETTINGS" />
        </Grid>

        <Border Grid.Row="1" Margin="0,13,0,13" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="GeneralTabButton" Tag="Active" Style="{StaticResource SettingsTabStyle}" Click="GeneralTab_OnClick" Content="GENERAL" />
                <Button x:Name="RobloxTabButton" Style="{StaticResource SettingsTabStyle}" Click="RobloxTab_OnClick" Content="ROBLOX" />
                <Button x:Name="DiscordTabButton" Style="{StaticResource SettingsTabStyle}" Click="DiscordTab_OnClick" Content="DISCORD" />
                <Button x:Name="KeybindsTabButton" Style="{StaticResource SettingsTabStyle}" Click="KeybindsTab_OnClick" Content="KEYBINDS" />
                <Button x:Name="DiagnosticsTabButton" Style="{StaticResource SettingsTabStyle}" Click="DiagnosticsTab_OnClick" Content="DIAGNOSTICS" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="GeneralPanel">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Appearance" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="THEME" />
                                    <Button x:Name="ThemeButton" Grid.Column="1" Width="142" HorizontalAlignment="Left" Style="{StaticResource SettingsButtonStyle}" Click="ThemeButton_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon x:Name="ThemeIcon" Width="14" Height="14" Margin="0,0,7,0" />
                                            <TextBlock x:Name="ThemeButtonText" Text="DARK MODE" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MACRO LAYOUT" />
                                    <ComboBox x:Name="LayoutProfileCombo" Grid.Column="1" Width="260" HorizontalAlignment="Left" SelectionChanged="DisplayOptions_OnChanged" />
                                </Grid>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MINIMIZE BEHAVIOR" />
                                    <StackPanel Grid.Column="1">
                                        <ComboBox x:Name="MinimizeBehaviorCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="DisplayOptions_OnChanged" />
                                        <TextBlock x:Name="CompactLayoutNote" Margin="0,5,0,0" FontSize="9" Foreground="{DynamicResource InkSoftBrush}" Visibility="Collapsed"
                                                   Text="Compact mode removes the dock and minimizes while running." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Updates and data" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MACRO VERSION" />
                                    <TextBlock x:Name="MacroVersionText" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="UPDATE OPTIONS" />
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="CheckUpdatesOnStartupCheck" Content="Check for updates on startup" Checked="UpdateOptions_OnChanged" Unchecked="UpdateOptions_OnChanged" />
                                        <CheckBox x:Name="IncludePrereleaseCheck" Margin="0,9,0,0" Content="Include prerelease builds" Checked="UpdateOptions_OnChanged" Unchecked="UpdateOptions_OnChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="ACTIONS" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource SettingsButtonStyle}" Click="CheckUpdates_OnClick" Content="CHECK NOW" />
                                        <Button x:Name="InstallUpdateButton" Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Background="{DynamicResource AccentBrush}"
                                                Visibility="Collapsed" Click="InstallUpdate_OnClick" Content="INSTALL UPDATE" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Tag="data" Click="LocalPath_OnClick" Content="OPEN DATA" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Tag="logs" Click="LocalPath_OnClick" Content="OPEN LOGS" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS" />
                                    <TextBlock x:Name="GeneralStatusText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Text="Session values only" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RobloxPanel" Visibility="Collapsed">
                    <local:LocalInstanceManagerPanel x:Name="LocalInstancesPanel" Margin="0,0,0,12" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Private server" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="PRIVATE-SERVER LINK" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PrivateServerText"
                                                 MaxLength="2048"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="PrivateServerText_OnTextChanged" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SettingsButtonStyle}" Click="TestPrivateServer_OnClick" Content="TEST LINK" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS" />
                                    <TextBlock x:Name="PrivateServerStatusText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Text="Not stored" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DiscordPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Webhook" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="DISCORD WEBHOOK" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="WebhookPassword"
                                                     MinHeight="38"
                                                     Padding="9,7"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     MaxLength="2048"
                                                     PasswordChanged="WebhookPassword_OnPasswordChanged" />
                                        <Button x:Name="TestWebhookButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Click="TestWebhook_OnClick" Content="TEST WEBHOOK" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS" />
                                    <TextBlock x:Name="WebhookStatusText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Text="No delivery attempted" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Failures" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="TERMINAL FAILURE" />
                                    <CheckBox x:Name="NotifyTerminalFailureCheck" Grid.Column="1" IsChecked="True" Content="Notify on terminal failure" Checked="DiscordFailureOptions_OnChanged" Unchecked="DiscordFailureOptions_OnChanged" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="DISCORD USER ID" />
                                    <TextBox x:Name="DiscordUserIdText" Grid.Column="1" Width="240" MaxLength="32" HorizontalAlignment="Left" TextChanged="DiscordFailureOptions_OnChanged" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="KeybindsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="Key bindings" />
                                <Button Width="110"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource DangerBrush}"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="ResetBindings_OnClick"
                                        Content="RESET KEYS" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <ItemsControl x:Name="KeyBindingsItems" ItemTemplate="{StaticResource SettingsKeyBindingTemplate}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Failure evidence" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="FAILURE EVIDENCE" />
                                    <StackPanel Grid.Column="1">
                                        <CheckBox IsChecked="True" Content="Capture frames on failure" Checked="SettingChanged_OnClick" Unchecked="SettingChanged_OnClick" />
                                        <CheckBox Margin="0,9,0,0" IsChecked="True" Content="Include current run log" Checked="SettingChanged_OnClick" Unchecked="SettingChanged_OnClick" />
                                        <CheckBox x:Name="DeepDebugCheck" Margin="0,9,0,0" Content="Deep debug trace" Checked="DeepDebug_OnChanged" Unchecked="DeepDebug_OnChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="FRAME HISTORY, MIN" />
                                    <TextBox x:Name="FrameHistoryText" Grid.Column="1" Width="95" HorizontalAlignment="Left" Text="15" LostKeyboardFocus="FrameHistory_OnLostKeyboardFocus" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="CAPTURE INTERVAL" />
                                    <ComboBox x:Name="CaptureIntervalCombo" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectionChanged="SettingChanged_OnSelectionChanged" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="ACTIONS" />
                                    <Button Grid.Column="1" Width="170" HorizontalAlignment="Left" Style="{StaticResource SettingsButtonStyle}" Click="OpenDiagnostics_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource Lucide.FolderOpen}" />
                                            <TextBlock Text="OPEN DEBUG FOLDER" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Recording" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MANUAL CONTROLS" />
                                    <CheckBox x:Name="ManualRecordingCheck" Grid.Column="1" Content="Enable manual recording controls" Checked="ManualRecording_OnChanged" Unchecked="ManualRecording_OnChanged" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="RECORDING NAME" />
                                    <Grid Grid.Column="1" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="RecordingNameText" Text="new route recording" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Click="ArmRecording_OnClick" Content="ARM" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS" />
                                    <TextBlock x:Name="DiagnosticsStatusText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Text="No recording armed" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
