<UserControl x:Class="LilacMacro.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LilacMacro.App.Controls"
             xmlns:local="clr-namespace:LilacMacro.App.Views"
             Focusable="True"
             Unloaded="SettingsPage_OnUnloaded"
             PreviewKeyDown="SettingsPage_OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SettingsTabStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource MutedBrush}" /></Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource MutedBrush}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style x:Key="SettingsFieldActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="15" />
        </Style>
        <Style x:Key="ThemeSwatchItemStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="43" />
            <Setter Property="Height" Value="43" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid ToolTip="{Binding Name}">
                            <Border x:Name="SwatchShadow"
                                    Margin="3,3,0,0"
                                    Background="{DynamicResource InkBrush}"
                                    CornerRadius="5" />
                            <Border x:Name="SwatchFace"
                                    Margin="0,0,3,3"
                                    Background="{Binding PreviewBrush}"
                                    BorderBrush="{DynamicResource InkBrush}"
                                    BorderThickness="2"
                                    CornerRadius="5" />
                            <Border x:Name="SelectedBadge"
                                    Width="17" Height="17"
                                    Margin="0,3,6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{Binding CheckBackdropBrush}"
                                    BorderBrush="{Binding CheckBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="Collapsed">
                                <controls:LucideIcon Width="10" Height="10"
                                                     Foreground="{Binding CheckBrush}"
                                                     Data="{StaticResource Lucide.Check}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchFace" Property="Margin" Value="0,0,4,4" />
                                <Setter TargetName="SwatchShadow" Property="Margin" Value="4,4,0,0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SwatchFace" Property="BorderThickness" Value="3" />
                                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwatchFace" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SettingsKeyBindingTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Scope}" />
                </StackPanel>
                <Button Grid.Column="1" Height="32" Style="{StaticResource SettingsButtonStyle}" Tag="{Binding}"
                        Click="KeyBindingButton_OnClick" Content="{Binding KeyName}" />
                <Button Grid.Column="3" Height="32" Padding="7,4" Tag="{Binding}"
                        Click="UnsetBinding_OnClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUnset}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <controls:LucideIcon Width="13" Height="13" Data="{StaticResource Lucide.X}" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock FontSize="19" FontWeight="Black" Text="SETTINGS" />
        </Grid>

        <Border Grid.Row="1" Margin="0,13,0,13" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="GeneralTabButton" Tag="Active" Style="{StaticResource SettingsTabStyle}" Click="GeneralTab_OnClick" Content="GENERAL" />
                <Button x:Name="RobloxTabButton" Style="{StaticResource SettingsTabStyle}" Click="RobloxTab_OnClick" Content="ROBLOX" />
                <Button x:Name="DiscordTabButton" Style="{StaticResource SettingsTabStyle}" Click="DiscordTab_OnClick" Content="DISCORD" />
                <Button x:Name="KeybindsTabButton" Style="{StaticResource SettingsTabStyle}" Click="KeybindsTab_OnClick" Content="KEYBINDS" />
                <Button x:Name="DiagnosticsTabButton" Style="{StaticResource SettingsTabStyle}" Click="DiagnosticsTab_OnClick" Content="DIAGNOSTICS" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="GeneralPanel">
                    <ContentControl x:Name="PrivacySettingsHost" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Theme" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MODE" />
                                    <Button x:Name="ThemeButton" Grid.Column="1" Width="142" HorizontalAlignment="Left" Style="{StaticResource SettingsButtonStyle}" Click="ThemeButton_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon x:Name="ThemeIcon" Width="14" Height="14" Margin="0,0,7,0" />
                                            <TextBlock x:Name="ThemeButtonText" Text="LIGHT MODE" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="COLOR THEME" />
                                    <ListBox x:Name="ThemePaletteList"
                                             Grid.Column="1"
                                             Width="500"
                                             Height="100"
                                             HorizontalAlignment="Left"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource ThemeSwatchItemStyle}"
                                             SelectionChanged="ThemePaletteList_OnSelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="10" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Macro window" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="LAYOUT" />
                                    <ComboBox x:Name="LayoutProfileCombo" Grid.Column="1" Width="260" HorizontalAlignment="Left" SelectionChanged="DisplayOptions_OnChanged" />
                                </Grid>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MINIMIZE BEHAVIOR" />
                                    <StackPanel Grid.Column="1">
                                        <ComboBox x:Name="MinimizeBehaviorCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="DisplayOptions_OnChanged" />
                                        <TextBlock x:Name="CompactLayoutNote" Margin="0,5,0,0" FontSize="9" Foreground="{DynamicResource InkSoftBrush}" Visibility="Collapsed"
                                                   Text="Compact mode removes the dock and minimizes while running." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Updates and data" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MACRO VERSION" />
                                    <TextBlock x:Name="MacroVersionText" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="INSTALLATION ID" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="InstallationIdText"
                                                 MinHeight="38"
                                                 Padding="9,7"
                                                 VerticalContentAlignment="Center"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 IsReadOnly="True"
                                                 Text="Loading..." />
                                        <Button x:Name="CopyInstallationIdButton"
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource SettingsFieldActionButtonStyle}"
                                                IsEnabled="False"
                                                Click="CopyInstallationId_OnClick">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:LucideIcon Width="13" Height="13" Margin="0,0,6,0" Data="{StaticResource Lucide.Copy}" />
                                                <TextBlock Text="COPY" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="UPDATE OPTIONS" />
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="CheckUpdatesOnStartupCheck" Content="Auto check for updates" Checked="UpdateOptions_OnChanged" Unchecked="UpdateOptions_OnChanged" />
                                        <CheckBox x:Name="IncludePrereleaseCheck" Margin="0,9,0,0" Content="Include prerelease builds" Checked="UpdateOptions_OnChanged" Unchecked="UpdateOptions_OnChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="ACTIONS" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource SettingsButtonStyle}" Click="CheckUpdates_OnClick" Content="CHECK NOW" />
                                        <Button x:Name="InstallUpdateButton" Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Background="{DynamicResource AccentBrush}"
                                                Visibility="Collapsed" Click="InstallUpdate_OnClick" Content="UPDATE" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Tag="data" Click="LocalPath_OnClick" Content="OPEN DATA" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource SettingsButtonStyle}" Tag="logs" Click="LocalPath_OnClick" Content="OPEN LOGS" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS" />
                                    <TextBlock x:Name="GeneralStatusText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" Text="Session values only" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RobloxPanel" Visibility="Collapsed">
                    <local:LocalInstanceManagerPanel x:Name="LocalInstancesPanel" Margin="0,0,0,12" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Private server" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="PRIVATE-SERVER LINK" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PrivateServerText"
                                                 MinHeight="38"
                                                 Padding="9,7"
                                                 MaxLength="2048"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="PrivateServerText_OnTextChanged" />
                                        <Button x:Name="TestPrivateServerButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SettingsFieldActionButtonStyle}" Click="TestPrivateServer_OnClick" Content="TEST LINK" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DiscordPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Webhook" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="DISCORD WEBHOOK" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="WebhookPassword"
                                                     MinHeight="38"
                                                     Padding="9,7"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     MaxLength="2048"
                                                     PasswordChanged="WebhookPassword_OnPasswordChanged" />
                                        <Button x:Name="TestWebhookButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SettingsFieldActionButtonStyle}" Click="TestWebhook_OnClick" Content="TEST WEBHOOK" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Events" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <UniformGrid Columns="2" Margin="240,0,0,0">
                                    <CheckBox x:Name="NotifyRunStartCheck" IsChecked="True" Content="Macro starts" Checked="DiscordEventOptions_OnChanged" Unchecked="DiscordEventOptions_OnChanged" />
                                    <CheckBox x:Name="NotifyRunStopCheck" IsChecked="True" Content="Macro stops" Checked="DiscordEventOptions_OnChanged" Unchecked="DiscordEventOptions_OnChanged" />
                                    <CheckBox x:Name="NotifyTaskChangeCheck" Margin="0,10,0,0" IsChecked="True" Content="Task changes" Checked="DiscordEventOptions_OnChanged" Unchecked="DiscordEventOptions_OnChanged" />
                                    <CheckBox x:Name="NotifyRecoveryCheck" Margin="0,10,0,0" IsChecked="True" Content="Recovery attempts" Checked="DiscordEventOptions_OnChanged" Unchecked="DiscordEventOptions_OnChanged" />
                                    <CheckBox x:Name="NotifyVictoryCheck" Margin="0,10,0,0" IsChecked="True" Content="Wins" Checked="DiscordEventOptions_OnChanged" Unchecked="DiscordEventOptions_OnChanged" />
                                    <CheckBox x:Name="NotifyDefeatCheck" Margin="0,10,0,0" IsChecked="True" Content="Losses" Checked="DiscordEventOptions_OnChanged" Unchecked="DiscordEventOptions_OnChanged" />
                                </UniformGrid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="TERMINAL FAILURE" />
                                    <CheckBox x:Name="NotifyTerminalFailureCheck" Grid.Column="1" Margin="0,12,0,0" IsChecked="True" Content="Notify and mention on terminal failure" Checked="DiscordEventOptions_OnChanged" Unchecked="DiscordEventOptions_OnChanged" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="DISCORD USER ID" />
                                    <TextBox x:Name="DiscordUserIdText" Grid.Column="1" Width="240" MaxLength="22" HorizontalAlignment="Left" TextChanged="DiscordEventOptions_OnChanged" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="KeybindsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="Key bindings" />
                                <Button Width="110"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource DangerBrush}"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="ResetBindings_OnClick"
                                        Content="RESET KEYS" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <ItemsControl x:Name="KeyBindingsItems" ItemTemplate="{StaticResource SettingsKeyBindingTemplate}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Text="Deep Debug" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LOGGING" />
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="DeepDebugCheck" Content="Enable Deep Debug Logs" Checked="DeepDebug_OnChanged" Unchecked="DeepDebug_OnChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="MAX LOG STORAGE, GB" />
                                    <TextBox x:Name="MaximumArchiveStorageText" Grid.Column="1" Width="95" HorizontalAlignment="Left" Text="10" LostKeyboardFocus="MaximumArchiveStorage_OnLostKeyboardFocus" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="ACTIONS" />
                                    <Button x:Name="OpenDeepDebugFolderButton" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource SettingsButtonStyle}" Click="OpenDiagnostics_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource Lucide.FolderOpen}" />
                                            <TextBlock Text="OPEN DEEP DEBUG FOLDER" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
