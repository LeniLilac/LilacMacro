<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PaperColor">#FFF7FB</Color>
    <Color x:Key="CardColor">#FFFDFE</Color>
    <Color x:Key="InkColor">#171116</Color>
    <Color x:Key="InkSoftColor">#62505B</Color>
    <Color x:Key="MutedColor">#F4DFEA</Color>
    <Color x:Key="AccentColor">#FF4FAC</Color>
    <Color x:Key="PinkColor">#FF4FAC</Color>
    <Color x:Key="YellowColor">#FFE15A</Color>
    <Color x:Key="SuccessColor">#26C982</Color>
    <Color x:Key="DangerColor">#FF5A68</Color>
    <Color x:Key="WarningColor">#926A1A</Color>
    <Color x:Key="PlanStateReadyColor">#DDF2E9</Color>
    <Color x:Key="PlanStateReadyTextColor">#176044</Color>
    <Color x:Key="PlanStateWaitingColor">#E8E4F5</Color>
    <Color x:Key="PlanStateWaitingTextColor">#514580</Color>
    <Color x:Key="PlanStateCooldownColor">#F4E6CE</Color>
    <Color x:Key="PlanStateCooldownTextColor">#745020</Color>
    <Color x:Key="PlanStateCompleteColor">#F3DFEA</Color>
    <Color x:Key="PlanStateCompleteTextColor">#7A355B</Color>
    <Color x:Key="MatchStepPlacementColor">#246BCE</Color>
    <Color x:Key="MatchStepReconfigureColor">#0F6F82</Color>
    <Color x:Key="MatchStepStartColor">#087F5B</Color>
    <Color x:Key="MatchStepDelayColor">#9A6700</Color>
    <Color x:Key="MatchStepUpgradeColor">#6941C6</Color>
    <Color x:Key="MatchStepSellColor">#C92A3A</Color>
    <Color x:Key="OnAccentColor">#171116</Color>
    <Color x:Key="BadgeIconColor">#171116</Color>
    <Color x:Key="CanvasColor">#21191F</Color>
    <Color x:Key="OcrMapSurfaceColor">#FFFDFE</Color>
    <Color x:Key="ChromeBorderColor">#34171116</Color>
    <Color x:Key="PressedSurfaceColor">#EDC9DB</Color>
    <Color x:Key="ScrollTrackColor">#24171116</Color>
    <Color x:Key="ScrollThumbColor">#8A62505B</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF4FAC</Color>
    <Color x:Key="ShadowColor">#FF171116</Color>
    <Color x:Key="AccentShadowColor">#66FF4FAC</Color>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="PlanStateReadyBrush" Color="{StaticResource PlanStateReadyColor}" />
    <SolidColorBrush x:Key="PlanStateReadyTextBrush" Color="{StaticResource PlanStateReadyTextColor}" />
    <SolidColorBrush x:Key="PlanStateWaitingBrush" Color="{StaticResource PlanStateWaitingColor}" />
    <SolidColorBrush x:Key="PlanStateWaitingTextBrush" Color="{StaticResource PlanStateWaitingTextColor}" />
    <SolidColorBrush x:Key="PlanStateCooldownBrush" Color="{StaticResource PlanStateCooldownColor}" />
    <SolidColorBrush x:Key="PlanStateCooldownTextBrush" Color="{StaticResource PlanStateCooldownTextColor}" />
    <SolidColorBrush x:Key="PlanStateCompleteBrush" Color="{StaticResource PlanStateCompleteColor}" />
    <SolidColorBrush x:Key="PlanStateCompleteTextBrush" Color="{StaticResource PlanStateCompleteTextColor}" />
    <SolidColorBrush x:Key="MatchStepPlacementBrush" Color="{StaticResource MatchStepPlacementColor}" />
    <SolidColorBrush x:Key="MatchStepReconfigureBrush" Color="{StaticResource MatchStepReconfigureColor}" />
    <SolidColorBrush x:Key="MatchStepStartBrush" Color="{StaticResource MatchStepStartColor}" />
    <SolidColorBrush x:Key="MatchStepDelayBrush" Color="{StaticResource MatchStepDelayColor}" />
    <SolidColorBrush x:Key="MatchStepUpgradeBrush" Color="{StaticResource MatchStepUpgradeColor}" />
    <SolidColorBrush x:Key="MatchStepSellBrush" Color="{StaticResource MatchStepSellColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="BadgeIconBrush" Color="{StaticResource BadgeIconColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="OcrMapSurfaceBrush" Color="{StaticResource OcrMapSurfaceColor}" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="{StaticResource ChromeBorderColor}" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="{StaticResource PressedSurfaceColor}" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />
    <DrawingBrush x:Key="AppBackgroundBrush" TileMode="Tile"
                  Viewport="0,0,26,26" ViewportUnits="Absolute"
                  Viewbox="0,0,26,26" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFF7FB" Geometry="M0,0 H26 V26 H0 Z" />
                <DrawingGroup Opacity="0.14">
                    <GeometryDrawing Brush="#171116">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="4,4" RadiusX="1" RadiusY="1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
                <DrawingGroup Opacity="0.05">
                    <GeometryDrawing Brush="#171116">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="18,0,1,15" Transform="1,0.22,-0.22,1,0,0" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
