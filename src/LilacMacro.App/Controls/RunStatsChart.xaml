<UserControl x:Class="LilacMacro.App.Controls.RunStatsChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ChartCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        </Style>
    </UserControl.Resources>
    <Border Padding="10"
            Background="{DynamicResource MutedBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TOTAL RUNS OVER TIME" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" Fill="{DynamicResource SuccessBrush}" />
                    <TextBlock x:Name="WinsText" Style="{StaticResource ChartCaptionStyle}" Text="0 W" />
                    <Ellipse Width="7" Height="7" Margin="12,0,5,0" Fill="{DynamicResource DangerBrush}" />
                    <TextBlock x:Name="LossesText" Style="{StaticResource ChartCaptionStyle}" Text="0 L" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,9,0,0" MinHeight="145" ClipToBounds="True">
                <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_OnSizeChanged" />
                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource ChartCaptionStyle}"
                           Text="NO COMPLETED RUNS" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
