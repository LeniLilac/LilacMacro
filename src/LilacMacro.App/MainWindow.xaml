<Window x:Class="LilacMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LilacMacro"
        Width="1450"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource InkBrush}"
                BorderThickness="0,0,0,3"
                MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
            <Grid Margin="15,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="34" Height="34" Margin="0,0,10,0">
                        <Border Margin="3,3,0,0" Background="{StaticResource InkBrush}" CornerRadius="4" />
                        <Border Margin="0,0,3,3"
                                Background="{StaticResource PinkBrush}"
                                BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="2"
                                CornerRadius="4">
                            <TextBlock Text="L" FontSize="19" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LilacMacro" FontSize="17" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Border x:Name="RobloxPill" Style="{StaticResource ChipStyle}" Background="{StaticResource MutedBrush}" Margin="0,0,9,0">
                        <TextBlock x:Name="RobloxPillText" Text="ROBLOX: CHECKING" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <Border x:Name="DatasetPill" Style="{StaticResource ChipStyle}" Background="{StaticResource YellowBrush}" Margin="0,0,9,0">
                        <TextBlock x:Name="DatasetPillText" Text="NO DATASET" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <Border x:Name="ManualCaptureKeyPill" Style="{StaticResource ChipStyle}" Background="{StaticResource MutedBrush}" Margin="0,0,9,0">
                        <TextBlock x:Name="ManualCaptureKeyPillText" Text="F5 STARTING" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <Border x:Name="CaptureKeyPill" Style="{StaticResource ChipStyle}" Background="{StaticResource MutedBrush}">
                        <TextBlock x:Name="CaptureKeyPillText" Text="F6 STARTING" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="42" Height="34" Margin="0,0,6,0" Style="{StaticResource ButtonStyle}" Padding="0" Content="—" Click="Minimize_OnClick" />
                    <Button Width="42" Height="34" Margin="0,0,6,0" Style="{StaticResource ButtonStyle}" Padding="0" Content="□" Click="Maximize_OnClick" />
                    <Button Width="42" Height="34" Style="{StaticResource DangerButtonStyle}" Padding="0" Content="×" Click="Close_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource MutedBrush}"
                BorderBrush="{StaticResource InkBrush}"
                BorderThickness="0,0,3,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Button x:Name="CaptureNav" Content="Capture" Style="{StaticResource NavButtonActiveStyle}" Click="CaptureNav_OnClick" />
                    <Button x:Name="ReviewNav" Content="Review + OCR" Style="{StaticResource NavButtonStyle}" Click="ReviewNav_OnClick" />
                    <Button x:Name="DatasetsNav" Content="Datasets" Style="{StaticResource NavButtonStyle}" Click="DatasetsNav_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <ContentControl x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>
