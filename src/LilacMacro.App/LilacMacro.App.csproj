<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LilacMacro.App</RootNamespace>
    <LilacMacroExecutableName Condition="'$(LilacMacroExecutableName)' == ''">LilacMacro</LilacMacroExecutableName>
    <AssemblyName>$(LilacMacroExecutableName)</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LilacMacro.Core\LilacMacro.Core.csproj" />
    <ProjectReference Include="..\LilacMacro.Windows\LilacMacro.Windows.csproj" />
    <ProjectReference Include="..\LilacMacro.Runtime\LilacMacro.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Diagnostics\*.cs" />
    <Compile Remove="Infrastructure\AppSettings.cs" />
    <Compile Remove="Infrastructure\AppSettingsStore.cs" />
    <Compile Remove="Infrastructure\OcrRunner.cs" />
    <Compile Remove="Infrastructure\OcrWorkerResponseReader.cs" />
    <Compile Remove="Infrastructure\OcrWorkerResult.cs" />
    <Compile Remove="Infrastructure\PersistentOcrWorker.cs" />
    <Compile Remove="Infrastructure\OcrGpuInfo.cs" />
    <Compile Remove="Infrastructure\OcrRunner.Setup.cs" />
    <Compile Remove="Workspace\CaptureProgress.cs" />
    <Compile Remove="Workspace\CrossProcessRobloxInputGate.cs" />
    <Compile Remove="Workspace\WorkspaceController.cs" />
    <Compile Remove="Workspace\WorkspaceController.WindowDiscovery.cs" />
    <Compile Remove="Workspace\WorkspaceController.Discord.cs" />
    <Compile Remove="Workspace\RobloxWindowAcquisitionWaiter.cs" />
    <Compile Remove="Workspace\WorkspaceInputCoordinator.cs" />
    <Compile Remove="Debugging\*.cs" />
    <Compile Include="Debugging\DebugKeySequenceCoordinator.cs" />
    <Compile Include="Debugging\DebugKeySequenceState.cs" />
    <Compile Include="Debugging\TeamScrollAbTestRunner.cs" />
    <Compile Include="Debugging\TeamSwapTestRunner.cs" />
    <Compile Remove="Runtime\ChallengePlacementResolver.cs" />
    <Compile Remove="Runtime\ChallengeRotationStore.cs" />
    <Compile Remove="Runtime\ExpeditionCheckpointService.cs" />
    <Compile Remove="Runtime\ExpeditionColorProfileStore.cs" />
    <Compile Remove="Runtime\ExpeditionEncounterService.cs" />
    <Compile Remove="Runtime\ExpeditionNodeEvidenceService.cs" />
    <Compile Remove="Runtime\ExpeditionOcrService.cs" />
    <Compile Remove="Runtime\ExpeditionRewardPoolService.cs" />
    <Compile Remove="Runtime\ExpeditionRewardProfileStore.cs" />
    <Compile Remove="Runtime\ExpeditionRewardPopupService.cs" />
    <Compile Remove="Runtime\ExpeditionSettingsService.cs" />
    <Compile Remove="Runtime\MatchTerminalService.cs" />
    <Compile Remove="Runtime\TerminalAwarePlacementSetup.cs" />
    <Compile Remove="Runtime\TowerPlacementResolver.cs" />
    <Compile Remove="Runtime\MatchWaveService.cs" />
    <Compile Remove="Runtime\MapPreparationService.cs" />
    <Compile Remove="Runtime\ModalActionLocator.cs" />
    <Compile Remove="Runtime\PlacementPlaybackService.cs" />
    <Compile Remove="Runtime\PlacementRuntimeContracts.cs" />
    <Compile Remove="Runtime\PrivateServerRejoinService.cs" />
    <Compile Remove="Runtime\RaidDropDismissalPolicy.cs" />
    <Compile Remove="Runtime\ResourceRefuelService.cs" />
    <Compile Remove="Runtime\CalendarClaimService.cs" />
    <Compile Remove="Runtime\CodeRedemptionService.cs" />
    <Compile Remove="Runtime\ShopPurchaseService.cs" />
    <Compile Remove="Runtime\UtilityTaskService.cs" />
    <Compile Remove="Runtime\UtilityRespawnService.cs" />
    <Compile Remove="Runtime\UnitPanelEvidenceService.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\tools\ocr_worker.py" Link="tools\ocr_worker.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\Setup-Ocr.ps1" Link="scripts\Setup-Ocr.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\OcrGpuRuntime.ps1" Link="scripts\OcrGpuRuntime.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PlacementMaps\*.jpg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveLegacyRuntimeEvidenceOutput" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)Assets\RuntimeEvidence" />
  </Target>
  <Target Name="CreateToolLaunchers"
          AfterTargets="Build"
          Condition="'$(UseAppHost)' != 'false' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).exe"
          DestinationFiles="$(TargetDir)LilacMacro.DatasetBuilder.exe"
          SkipUnchangedFiles="true"
          Condition="'$(AssemblyName)' != 'LilacMacro.DatasetBuilder'" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).exe"
          DestinationFiles="$(TargetDir)LilacMacro.RuntimeLab.exe"
          SkipUnchangedFiles="true"
          Condition="'$(AssemblyName)' != 'LilacMacro.RuntimeLab'" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).exe"
          DestinationFiles="$(TargetDir)LilacMacro.DeepDebugViewer.exe"
          SkipUnchangedFiles="true"
          Condition="'$(AssemblyName)' != 'LilacMacro.DeepDebugViewer'" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)LilacMacro.DatasetBuilder.exe"
                  Condition="'$(AssemblyName)' != 'LilacMacro.DatasetBuilder'" />
      <FileWrites Include="$(TargetDir)LilacMacro.RuntimeLab.exe"
                  Condition="'$(AssemblyName)' != 'LilacMacro.RuntimeLab'" />
      <FileWrites Include="$(TargetDir)LilacMacro.DeepDebugViewer.exe"
                  Condition="'$(AssemblyName)' != 'LilacMacro.DeepDebugViewer'" />
    </ItemGroup>
  </Target>
  <Target Name="CreatePublishedToolLaunchers"
          AfterTargets="Publish"
          Condition="'$(UseAppHost)' != 'false' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)LilacMacro.DatasetBuilder.exe"
          SkipUnchangedFiles="true"
          Condition="'$(AssemblyName)' != 'LilacMacro.DatasetBuilder'" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)LilacMacro.RuntimeLab.exe"
          SkipUnchangedFiles="true"
          Condition="'$(AssemblyName)' != 'LilacMacro.RuntimeLab'" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)LilacMacro.DeepDebugViewer.exe"
          SkipUnchangedFiles="true"
          Condition="'$(AssemblyName)' != 'LilacMacro.DeepDebugViewer'" />
  </Target>
</Project>
