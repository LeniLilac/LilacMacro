<Window x:Class="LilacMacro.App.DeepDebugViewer.DeepDebugViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LilacMacro.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LilacMacro / Deep Debug Viewer"
        Width="1500" Height="900" MinWidth="1040" MinHeight="650"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" AllowDrop="True"
        KeyDown="Window_KeyDown" DragOver="Window_DragOver" Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="MetricStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource InkBrush}" BorderThickness="0,0,0,3"
                MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
            <Grid Margin="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:LucideIcon Data="{StaticResource Lucide.FileArchive}"
                                         Width="17" Height="17" Margin="0,0,9,0"
                                         Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="Deep Debug Viewer" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ArchivePathText" Grid.Column="1" Margin="20,0"
                           Text="DROP A DEEP DEBUG ZIP OR OPEN ARCHIVE"
                           Foreground="{DynamicResource InkSoftBrush}" FontFamily="{StaticResource MonoFont}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Click="OpenArchive_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:LucideIcon Data="{StaticResource Lucide.FolderOpen}" Width="15" Height="15"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Margin="0,0,7,0" />
                            <TextBlock Text="OPEN ARCHIVE" />
                        </StackPanel>
                    </Button>
                    <Button Width="42" Height="36" MinHeight="0" Padding="0" Margin="0,0,8,0"
                            Click="Theme_Click" ToolTip="Toggle theme">
                        <controls:LucideIcon x:Name="ThemeIcon" Data="{StaticResource Lucide.Moon}"
                                             Width="16" Height="16"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click">
                        <controls:LucideIcon Data="{StaticResource Lucide.Minus}" Width="14" Height="14"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" Margin="6,0" Click="Maximize_Click">
                        <controls:LucideIcon Data="{StaticResource Lucide.Square}" Width="13" Height="13"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" Background="{DynamicResource DangerBrush}"
                            Click="Close_Click">
                        <controls:LucideIcon Data="{StaticResource Lucide.X}" Width="14" Height="14"
                                             Foreground="{DynamicResource OnAccentBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricStyle}">
                <StackPanel>
                    <TextBlock Text="OPERATION" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock x:Name="OperationText" Text="NO ARCHIVE" FontWeight="Bold" FontSize="15"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricStyle}">
                <StackPanel>
                    <TextBlock Text="OUTCOME" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock x:Name="OutcomeText" Text="—" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricStyle}">
                <StackPanel>
                    <TextBlock Text="RUNTIME" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock x:Name="RuntimeText" Text="—" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricStyle}">
                <StackPanel>
                    <TextBlock Text="FRAMES" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock x:Name="FrameCountText" Text="0" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="EVENTS / INPUT" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock x:Name="EventCountText" Text="0 / 0" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="14,0,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="580" />
                <ColumnDefinition Width="500" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,12,0">
                <Grid Background="{DynamicResource PaperBrush}">
                    <Viewbox x:Name="FrameViewbox" Stretch="Uniform">
                        <Grid x:Name="FrameSurface" Width="1366" Height="700">
                            <Image x:Name="FrameImage" Stretch="Fill" />
                            <Canvas x:Name="InputMarkerCanvas" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                    <Border x:Name="PreviewMessageBorder" Background="{DynamicResource PaperBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <controls:LucideIcon x:Name="PreviewMessageIcon"
                                                 Data="{StaticResource Lucide.FileArchive}"
                                                 Width="34" Height="34" HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource InkSoftBrush}" />
                            <TextBlock x:Name="PreviewMessageText" Margin="0,14,0,0"
                                       Text="DROP A DEEP DEBUG ZIP HERE"
                                       TextAlignment="Center" TextWrapping="Wrap" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EVENTS" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="InputMarkersToggle" Grid.Column="1" Content="INPUT MARKERS"
                                  IsChecked="True" Checked="InputMarkers_Changed" Unchecked="InputMarkers_Changed" />
                    </Grid>
                    <TextBlock x:Name="EventContextText" Grid.Row="1" Margin="0,0,0,8"
                               Text="NO FRAME SELECTED" Style="{StaticResource EyebrowStyle}" />
                    <ListBox x:Name="EventList" Grid.Row="2" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9" Background="{DynamicResource MutedBrush}"
                                        BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource InkSoftBrush}" FontSize="10" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Heading}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource InkSoftBrush}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="14,0,14,14" Style="{StaticResource CardStyle}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FramePathText" Text="NO FRAME" FontFamily="{StaticResource MonoFont}"
                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="760" />
                        <TextBlock x:Name="TimestampText" Margin="18,0,0,0" Text="—"
                                   Foreground="{DynamicResource InkSoftBrush}" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="READY"
                               Foreground="{DynamicResource InkSoftBrush}" FontFamily="{StaticResource MonoFont}" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PreviousButton" Style="{StaticResource TransportButtonStyle}" IsEnabled="False" Click="Previous_Click">
                            <controls:LucideIcon Data="{StaticResource Lucide.SkipBack}" Width="16" Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButtonStyle}" Margin="7,0"
                                IsEnabled="False" Click="PlayPause_Click">
                            <controls:LucideIcon x:Name="PlayPauseIcon" Data="{StaticResource Lucide.Play}" Width="16" Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource TransportButtonStyle}" IsEnabled="False" Click="Next_Click">
                            <controls:LucideIcon Data="{StaticResource Lucide.SkipForward}" Width="16" Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                    <Slider x:Name="TimelineSlider" Grid.Column="1" Margin="14,0" Minimum="0" Maximum="0"
                            IsEnabled="False" VerticalAlignment="Center" ValueChanged="TimelineSlider_ValueChanged" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FramePositionText" Text="0 / 0" Margin="0,0,14,0"
                                   FontFamily="{StaticResource MonoFont}" FontWeight="Bold" VerticalAlignment="Center" />
                        <ComboBox x:Name="SpeedCombo" Width="90" SelectedIndex="2"
                                  SelectionChanged="SpeedCombo_SelectionChanged">
                            <ComboBoxItem Content="0.25×" Tag="0.25" />
                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                            <ComboBoxItem Content="1×" Tag="1" />
                            <ComboBoxItem Content="2×" Tag="2" />
                            <ComboBoxItem Content="4×" Tag="4" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
