<Window x:Class="LilacMacro.App.MacroShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LilacMacro.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LilacMacro"
        Width="1800"
        Height="1000"
        MinWidth="1060"
        MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BrowserTabStyle" TargetType="Button">
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Tag" Value="Inactive" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="1,0">
                            <Border x:Name="Face"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Separator"
                                    Width="1"
                                    Height="16"
                                    Margin="0,0,-1,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource InkBrush}"
                                    Opacity="0.16" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter TargetName="Separator" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource MutedBrush}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
                                <Setter TargetName="Separator" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Separator" Property="Opacity" Value="0.08" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserTabActiveStyle"
               TargetType="Button"
               BasedOn="{StaticResource BrowserTabStyle}">
            <Setter Property="Tag" Value="Active" />
            <Setter Property="FontWeight" Value="Black" />
        </Style>

        <Style x:Key="BrowserTabIconStyle" TargetType="controls:LucideIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style x:Key="BrowserWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="ToastCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="0,0,0,3"
                MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
            <Grid Margin="8,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MacroTab" Click="MacroTab_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Style="{StaticResource BrowserTabIconStyle}"
                                                     Data="{StaticResource Lucide.Play}" />
                                <TextBlock VerticalAlignment="Center" Text="Macro" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlanTab" Click="PlanTab_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Style="{StaticResource BrowserTabIconStyle}"
                                                     Data="{StaticResource Lucide.ListChecks}" />
                                <TextBlock VerticalAlignment="Center" Text="Plan" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SetupTab" Click="SetupTab_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Style="{StaticResource BrowserTabIconStyle}"
                                                     Data="{StaticResource Lucide.Crosshair}" />
                                <TextBlock VerticalAlignment="Center" Text="Setup" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsTab" Click="SettingsTab_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Style="{StaticResource BrowserTabIconStyle}"
                                                     Data="{StaticResource Lucide.Settings2}" />
                                <TextBlock VerticalAlignment="Center" Text="Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="InstanceNameText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkSoftBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                            Margin="0,0,6,0"
                            Style="{StaticResource BrowserWindowButtonStyle}"
                            Click="Minimize_OnClick">
                        <controls:LucideIcon Width="16"
                                             Height="16"
                                             Data="{StaticResource Lucide.Minus}" />
                    </Button>
                    <Button
                            Margin="0,0,6,0"
                            Style="{StaticResource BrowserWindowButtonStyle}"
                            Click="Maximize_OnClick">
                        <controls:LucideIcon Width="15" Height="15">
                            <controls:LucideIcon.Style>
                                <Style TargetType="controls:LucideIcon">
                                    <Setter Property="Data" Value="{StaticResource Lucide.Square}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="Maximized">
                                            <Setter Property="Data" Value="{StaticResource Lucide.Copy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:LucideIcon.Style>
                        </controls:LucideIcon>
                    </Button>
                    <Button Background="{DynamicResource DangerBrush}"
                            Style="{StaticResource BrowserWindowButtonStyle}"
                            Click="Close_OnClick">
                        <controls:LucideIcon Width="16"
                                             Height="16"
                                             Data="{StaticResource Lucide.X}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}">
            <ContentControl x:Name="PageHost" />
        </Grid>

        <Border x:Name="ErrorToast" Grid.Row="0" Grid.RowSpan="2"
                Width="370" Margin="0,0,18,18" Padding="14"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Panel.ZIndex="100" Visibility="Collapsed"
                Background="{DynamicResource DangerBrush}"
                BorderBrush="{DynamicResource InkBrush}" BorderThickness="3" CornerRadius="7">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" ShadowDepth="5"
                                  Direction="315" BlurRadius="0" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:LucideIcon Width="19" Height="19" Margin="0,1,11,0"
                                     Foreground="{DynamicResource OnAccentBrush}"
                                     Data="{StaticResource Lucide.TriangleAlert}" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ErrorToastTitle" FontSize="12" FontWeight="Black"
                               Foreground="{DynamicResource OnAccentBrush}" />
                    <TextBlock x:Name="ErrorToastMessage" Margin="0,7,0,0" FontSize="12"
                               Foreground="{DynamicResource OnAccentBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Margin="9,-4,-4,0" VerticalAlignment="Top"
                        Style="{StaticResource ToastCloseButtonStyle}"
                        Click="ToastDismiss_OnClick">
                    <controls:LucideIcon Width="14" Height="14" Data="{StaticResource Lucide.X}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
